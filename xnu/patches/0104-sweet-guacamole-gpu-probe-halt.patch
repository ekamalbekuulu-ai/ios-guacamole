diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -123,6 +123,55 @@
 #define GMU_PWR_COL_INTER_FRAME_CTRL (0x50c0u * 4u)
 #define GMU_PWR_COL_CP_MSG	(0x5100u * 4u)
 #define GMU_RPMH_CTRL		(0x50e8u * 4u)
+/*
+ * Ported from the mainline msm driver (a6xx_gmu.xml offsets are dwords from
+ * the GPU block at 0x02c00000; sweet maps the GMU at 0x02c6a000, so subtract
+ * 0x6a000):  GMU_RSCC_CONTROL_REQ 0x23b07, ACK 0x23b08, HFI_CTRL_INIT 0x1f986.
+ */
+#define GMU_RSCC_CONTROL_REQ	0x24C1Cu
+#define GMU_RSCC_CONTROL_ACK	0x24C20u
+#define GMU_HFI_CTRL_INIT	0x14618u
+
+/*
+ * RPMh/PDC/RSCC blocks (sm8150.dtsi: gmu_pdc @0x0b290000, gmu_pdc_seq
+ * @0x0b490000; mainline msm maps the RSC sequencer at gmu + 0x23000).
+ */
+#define GPU_PDC_PA		0x0b290000u
+#define GPU_PDC_SEQ_PA		0x0b490000u
+#define GPU_RSCC_PA		0x02c23000u
+#define GPU_PDC_SIZE		0x00010000u
+#define GPU_RSCC_SIZE		0x00002000u
+
+/* PDC (gmu_pdc) dword offsets from a6xx.xml A6XX_PDC. */
+#define PDC_GPU_ENABLE_PDC		0x1140u
+#define PDC_GPU_SEQ_START_ADDR		0x1148u
+#define PDC_GPU_TCS1_CONTROL		0x1572u
+#define PDC_GPU_TCS1_CMD_ENABLE_BANK	0x1573u
+#define PDC_GPU_TCS1_CMD_WAIT_CMPL	0x1574u
+#define PDC_GPU_TCS1_CMD0_MSGID		0x1575u
+#define PDC_GPU_TCS1_CMD0_ADDR		0x1576u
+#define PDC_GPU_TCS1_CMD0_DATA		0x1577u
+#define PDC_GPU_TCS3_CONTROL		0x15d6u
+#define PDC_GPU_TCS3_CMD_ENABLE_BANK	0x15d7u
+#define PDC_GPU_TCS3_CMD_WAIT_CMPL	0x15d8u
+#define PDC_GPU_TCS3_CMD0_MSGID		0x15d9u
+#define PDC_GPU_TCS3_CMD0_ADDR		0x15dau
+#define PDC_GPU_TCS3_CMD0_DATA		0x15dbu
+
+/* RSCC (gmu + 0x23000) dword offsets from a6xx_gmu.xml. */
+#define RSCC_RSC_STATUS0_DRV0	0x0004u
+#define RSCC_PDC_SEQ_START_ADDR	0x0008u
+#define RSCC_PDC_MATCH_VALUE_LO	0x0009u
+#define RSCC_PDC_MATCH_VALUE_HI	0x000au
+#define RSCC_PDC_SLAVE_ID_DRV0	0x000bu
+#define RSCC_HIDDEN_TCS_CMD0_ADDR 0x000du
+#define RSCC_HIDDEN_TCS_CMD0_DATA 0x000eu
+#define RSCC_OVERRIDE_START_ADDR 0x0100u
+#define RSCC_SEQ_BUSY_DRV0	0x0101u
+#define RSCC_SEQ_MEM_0_DRV0	0x0180u
+
+/* a640 family PDC address offset (mainline a6xx_gmu_rpmh_init). */
+#define PDC_ADDRESS_OFFSET	0x30090u
 
 /* GPU SMMU (SMMU-500), GR0 global and stream-match registers. */
 #define GPU_SMMU_PA		0x02ca0000u
@@ -532,7 +581,7 @@
 static vm_offset_t
 gpu_rpmh_init(void)
 {
-	vm_offset_t rscc = ml_io_map(0x18220000u, 0x10000u);
+	vm_offset_t rscc = ml_io_map(0x02c23000u, 0x10000u);
 	vm_offset_t pdc = ml_io_map(0xb290000u, 0x10000u);
 	vm_offset_t seq = ml_io_map(0xb490000u, 0x10000u);
 
@@ -798,17 +847,32 @@
 		mask = 0x1ffu;
 		reset = 0x100u;
 	}
-	if (!layout_ok || !rscc_ok) {
+	/*
+	 * sweetgpu_force=1: boot the CM3 even when the pre-flight gates failed.
+	 * The gates exist because SID 4/5 are not programmed yet (SMMU faults are
+	 * expected at this stage) and the RSCC qmp handshake is not implemented;
+	 * stage 0 only wants FW_INIT_RESULT, so allow an explicit override.
+	 */
+	int force = 0;
+	PE_parse_boot_argn("sweetgpu_force", &force, sizeof(force));
+	if ((!layout_ok || !rscc_ok) && !force) {
 		printf("SWEET GPU: GMU boot gated layout=%d rscc=%d; not resetting CM3\n",
 		    layout_ok, rscc_ok);
 		gpu_wr(gmu, GMU_CM3_SYSRESET, 1);
 		goto restore;
 	}
+	if ((!layout_ok || !rscc_ok) && force) {
+		printf("SWEET GPU: gates failed (layout=%d rscc=%d) but sweetgpu_force=1: booting CM3 anyway\n",
+		    layout_ok, rscc_ok);
+	}
 	gpu_wr(gmu, GMU_CM3_FW_INIT_RESULT, 0);
 	gpu_wr(gmu, GMU_CM3_BOOT_CONFIG, 0x02);
+	/* mainline a6xx_gmu_fw_start(): keep TCM retention on. */
+	gpu_wr(gmu, GMU_GENERAL_7, 1);
 	gpu_wr(gmu, GMU_HFI_QTBL_ADDR, hfi_va ? 0x60001000u : 0);
 	gpu_wr(gmu, GMU_HFI_QTBL_INFO, hfi_va ? 1u : 0);
-	gpu_wr(gmu, GMU_AHB_FENCE_RANGE_0, 0x80a008a0u);
+	/* mainline builds this as BIT(31) | upper(0xa)<<18 | lower(0xa0). */
+	gpu_wr(gmu, GMU_AHB_FENCE_RANGE_0, 0x802800a0u);
 	gpu_wr(gmu, GMU_HFI_SFR_ADDR, 0x06040100u);
 	/* Clear the CM3 NMI bit so the CM3 runs __main, not the NMI handler. */
 	gpu_wr(gmu, GMU_CM3_CFG, 0x4052u);
@@ -849,6 +913,24 @@
 	}
 	printf("SWEET GPU: gmu boot last=%#x want=%#x/%#x init=%#x %s\n",
 	    last, reset, mask, init, init_ok ? "ok" : "timeout");
+	/*
+	 * a6xx_gmu_hfi_start(): once FW_INIT_RESULT is in, kick the HFI queues
+	 * and wait for the controller to report ready.
+	 */
+	if (init_ok) {
+		uint32_t st = 0;
+
+		gpu_wr(gmu, GMU_HFI_CTRL_INIT, 1);
+		for (unsigned i = 0; i < 100; ++i) {
+			st = gpu_rd(gmu, GMU_HFI_CTRL_STATUS);
+			if (st & 1u) {
+				break;
+			}
+			delay(10);
+		}
+		printf("SWEET GPU: hfi start status=%#x %s\n", st,
+		    (st & 1u) ? "ready" : "timeout");
+	}
 	printf("SWEET GPU: gmu boot intr=%#x gmu2host=%#x hfi=%#x fault=%d\n",
 	    gpu_rd(gmu, GMU_AO_HOST_INTR_STATUS),
 	    gpu_rd(gmu, GMU_GMU2HOST_INTR_INFO),
@@ -1045,6 +1127,21 @@
 	    gpu_rd(gpucc, GPUCC_GMU_BCR), gpu_rd(gpucc, GPUCC_RCG_CMD));
 	printf("SWEET GPU: gpucc gdscr gx=%#x cx=%#x\n",
 	    gpu_rd(gpucc, GPUCC_GX_GDSCR), gpu_rd(gpucc, GPUCC_CX_GDSCR));
+
+	/*
+	 * sweetgpu_halt=1: freeze here so the probe output stays on the panel.
+	 * There is no serial port and the console scrolls away as the boot
+	 * continues, so a frozen screen is the only way to read the registers.
+	 */
+	{
+		int halt = 0;
+		if (PE_parse_boot_argn("sweetgpu_halt", &halt, sizeof(halt)) && halt) {
+			printf("SWEET GPU: probe done, halting (sweetgpu_halt=1)\n");
+			for (;;) {
+				__asm__ __volatile__("wfe");
+			}
+		}
+	}
 }
 
 #endif /* ARM64_BOARD_CONFIG_GUACAMOLE */
