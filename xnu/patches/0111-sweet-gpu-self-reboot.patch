+			 * and then drop PS_HOLD, so the phone comes back in fastboot on
+			 * its own and the next image can be flashed without anyone
+			 * touching it. The ring log survives in userdata, so the
+			 * previous run's output is read back with TWRP afterwards.
+			 */
+			printf("SWEET GPU: probe done, rebooting to bootloader (sweetgpu_reboot=1)\n");
+			vm_offset_t imem = ml_io_map(SWEET_IMEM_RESTART_REASON & ~0xfffu, 0x1000u);
+			if (imem != 0) {
+				*(volatile uint32_t *)(imem + (SWEET_IMEM_RESTART_REASON & 0xfffu)) = 0x77665500u;
