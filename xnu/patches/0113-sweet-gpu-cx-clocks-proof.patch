+
 static uint32_t
 gpu_rd(vm_offset_t base, uint32_t off)
 {
@@ -241,6 +255,48 @@
 	uint32_t after = gpu_rd(gcc, off);
 	printf("SWEET GPU: %s %#x -> %#x%s\n", name, before, after,
 	    gpu_clk_on(after) ? "" : " (still halted)");
+}
+
+/*
+ * Ported from the K90/HackiOS driver's "prove the block answers, then write"
+ * discipline (adreno8_cx.c: adreno8_clock_on/adreno8_gpucc_answers): every
+ * branch is enabled, read back and reported, and a required one that stays
+ * halted aborts the caller instead of letting it write into a gated block.
+ */
+static bool
+gpu_cx_side_clocks(vm_offset_t gpucc)
+{
+	static const struct {
+		const char *name;
+		uint32_t    off;
+		bool        must;
+	} clks[] = {
+		{ "gpu_cc_cx_apb_clk",      GPUCC_CX_APB_CLK,      true  },
+		{ "gpu_cc_cx_snoc_dvm_clk", GPUCC_CX_SNOC_DVM_CLK, true  },
+		{ "gpu_cc_cxo_aon_clk",     GPUCC_CXO_AON_CLK,     true  },
+		{ "gpu_cc_crc_ahb_clk",     GPUCC_CRC_AHB_CLK,     false },
+	};
+	bool ok = true;
+
+	for (unsigned i = 0; i < sizeof(clks) / sizeof(clks[0]); ++i) {
+		uint32_t before = gpu_rd(gpucc, clks[i].off);
+		uint32_t after;
+		bool on;
+
+		gpu_wr(gpucc, clks[i].off, before | 1u);
+		after = gpu_rd(gpucc, clks[i].off);
+		for (unsigned k = 0; k < 100 && !gpu_clk_on(after); ++k) {
+			delay(10);
+			after = gpu_rd(gpucc, clks[i].off);
+		}
+		on = gpu_clk_on(after);
+		printf("SWEET GPU: %-24s %#010x -> %#010x (%s)\n",
+		    clks[i].name, before, after, on ? "on" : "STILL HALTED");
+		if (!on && clks[i].must) {
+			ok = false;
+		}
+	}
+	return ok;
 }
 
