+/*
+ * The CX-side branches the RSCC/PDC sit behind, from the vendor clock driver
+ * (gpucc-sm8150.c): gpu_cc_cx_apb_clk 0x1088, gpu_cc_cx_snoc_dvm_clk 0x108c,
+ * gpu_cc_cxo_aon_clk 0x1004, gpu_cc_crc_ahb_clk 0x107c. None of these were
+ * ever enabled here, and a write to an APB block whose APB clock is gated
+ * wedges the NoC while a read can still be answered - exactly the "reads are
+ * fine, every write lands in EDL" behaviour seen with RSCC_RSC_STATUS0.
+ */
+#define GPUCC_CX_APB_CLK	0x1088u
+#define GPUCC_CX_SNOC_DVM_CLK	0x108cu
+#define GPUCC_CXO_AON_CLK	0x1004u
+#define GPUCC_CRC_AHB_CLK	0x107cu
 #define GPUCC_GX_CFG_GDSCR	0x1010u		/* BIT(16) GX power up */
 #define GPUCC_CX_HW_CTRL	0x1540u		/* BIT(31) = CX on */
 
