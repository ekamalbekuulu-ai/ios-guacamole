+++ b/bsd/dev/sweet_gpu.c
@@ -1261,6 +1261,16 @@
 				*(volatile uint32_t *)(imem + (SWEET_IMEM_RESTART_REASON & 0xfffu)) = 0x77665500u;
 				__asm__ volatile("dsb sy" ::: "memory");
 			}
+			/*
+			 * A clean architectural reset, not a PS_HOLD power collapse:
+			 * dropping PS_HOLD looks like an unexpected power loss and
+			 * ABL answers it with a crash dump / EDL. PSCI SYSTEM_RESET
+			 * (0x84000009) keeps the IMEM restart reason intact, so ABL
+			 * comes up in fastboot as asked.
+			 */
+			register unsigned long x0 __asm__("x0") = 0x84000009UL;
+			__asm__ volatile("smc #0" : : "r"(x0) : "memory", "x1", "x2", "x3");
+			/* Only reached if PSCI refused the reset. */
 			vm_offset_t pm = ml_io_map(SWEET_PSHOLD, 0x1000u);
 			if (pm != 0) {
 				*(volatile uint32_t *)pm = 0;
