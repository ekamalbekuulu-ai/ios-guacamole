+static int
+rh_send(uint32_t address, unsigned mv)
+{
+	const uint32_t offsets[3] = {0, 8, 4};
+	const uint32_t values[3] = {mv, 7, 1};
+	char label[40];
+
+	/* HPM (raw 7) is supported by this PMIC5 LDO; enable comes last. */
+	snprintf(label, sizeof(label), "L11C %u mV mode=7 enable=1", mv);
+	return rh_send_cmds(address, offsets, values, 3, label);
+}
+
+/*
+ * Vote an ARC rail through RPMh. corner is the index into the resource's
+ * command-DB level table (rpmhpd.c sends cmd.data = corner), not the GMU
+ * HFI packed vote. -1 selects the first non-zero level (rpmhpd's
+ * enable_corner); 0 votes the rail off.
+ */
+int
+sweet_rpmh_arc_set(const char *res, int corner)
+{
+	uint32_t address = 0, table = 0, bytes = 0;
+	unsigned count, i;
+	int error = EIO;
+
+	if (!res) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing ARC vote\n");
+		goto out;
+	}
+	error = rh_map();
+	if (error) {
+		goto out;
+	}
+	error = rh_arc_lookup(res, &address, &table, &bytes);
+	if (error) {
+		goto out;
+	}
+	count = bytes / 2;
+	if (corner < 0) {
+		i = 0;
+		if (!rh_db16(table)) {
+			for (i = 1; i < count && !rh_db16(table + 2u * i); ++i) {
+			}
+		}
+		if (i == count) {
+			printf("SWEET RPMH: %s has no non-zero ARC level\n", res);
+			error = ENODEV;
+			goto out;
+		}
+		corner = (int)i;
+	}
+	if ((unsigned)corner >= count) {
+		printf("SWEET RPMH: %s ARC corner %d out of range (%u levels)\n",
+		    res, corner, count);
+		error = EINVAL;
+		goto out;
+	}
+	const uint32_t offsets[1] = {0};
+	const uint32_t values[1] = {(uint32_t)corner};
+	char label[48];
+
+	snprintf(label, sizeof(label), "%s ARC corner %d %s", res, corner,
+	    corner ? "on" : "off");
+	error = rh_send_cmds(address, offsets, values, 1, label);
+out:
+	if (error) {
+		printf("SWEET RPMH: ARC %s corner %d failed errno=%d",
+		    res ? res : "?", corner, error);
+		if (corner < 0) {
+			printf(" (auto)\n");
+		} else {
+			printf("\n");
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
