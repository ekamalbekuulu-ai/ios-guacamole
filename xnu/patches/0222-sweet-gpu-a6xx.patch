sweet-gpu-a6xx: the Adreno 640 kernel driver and its build wiring

sweet_a6xx.c is the core proven in bare metal by shim-rmx (GMU, HFI,
SMMU, SQE, CP, zap, blit); sweet_a6xx_host.c is the kernel environment
for it. The only changes to existing files are the two bsd/conf/files
entries and one call next to sweet_gpu_init().

diff --git a/bsd/dev/sweet_a6xx.h b/bsd/dev/sweet_a6xx.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_a6xx.h
@@ -0,0 +1,167 @@
+/*
+ * Adreno 640 core shared by the kernel (bsd/dev/sweet_gpu.c) and the
+ * userland bring-up tool (phone/gpu/gpu.c, built from this same file): power
+ * and GMU boot, HFI, SMMU banks, SQE + CP + zap shader, ringbuffer
+ * submission, 4K page mappings, and the 2D blit stream.
+ *
+ * The environment supplies the a6_* hooks below (physical register and
+ * memory access, delays, logging, SMC, firmware).
+ *
+ * One 16 MB contiguous pool (2 MB aligned) holds the GPU's own memory:
+ *
+ *   pool + 0x000000  GMU page tables, icache/dcache windows, log, HFI
+ *   pool + 0x0a0000  zap shader metadata for TrustZone
+ *   pool + 0x100000  GPU page tables: L1, L2 (2 MB blocks), then an arena of 4K tables
+ *   pool + 0x200000  SQE microcode
+ *   pool + 0x210000  ringbuffer (32 KB)
+ *   pool + 0x218000  scratch: fence (+0), tests (+0x100..), border colours (+0x800), event timestamps (+0x900)
+ *   pool + 0x400000  free for the environment (userland: named buffers)
+ *
+ * GPU VA (39 bits): the pool at 0x10000000, the panel framebuffer at
+ * 0x20000000, everything else (surfaces, replayed buffers) mapped with 4K
+ * pages from 4 GB up.
+ */
+#ifndef SWEET_A6XX_H
+#define SWEET_A6XX_H
+#ifdef KERNEL
+#include <sys/types.h>
+#include <stdarg.h>
+#else
+#include <stddef.h>
+#include <stdint.h>
+#include <stdbool.h>
+#endif
+
+#define A6_POOL_SIZE		0x1000000ull
+#define A6_POOL_ALIGN		0x200000ull
+#define A6_OFF_ZAP_META		0x0a0000ull
+#define A6_OFF_GT_L1		0x100000ull
+#define A6_OFF_GT_L2		0x101000ull
+#define A6_OFF_PT_ARENA		0x102000ull
+#define A6_OFF_SQE		0x200000ull
+#define A6_OFF_RING		0x210000ull
+#define A6_OFF_SCRATCH		0x218000ull
+#define A6_OFF_FREE		0x400000ull
+
+#define A6_GVA_POOL		0x10000000ull
+#define A6_GVA_FB		0x20000000ull
+#define A6_RING_SIZE		0x8000u
+#define A6_RING_DW		(A6_RING_SIZE / 4)
+
+#define A6_FB_PA		0x9c000000ull	/* guacamole cont_splash_region (stock DTB) */
+#define A6_FB_SIZE		0x1200000ull	/* 1440x3120x4 = 17.97 MB rounded up */
+
+#define A6_GPU_ID		640
+#define A6_CHIP_ID		0x06040001ull
+
+struct a6_gpu {
+	uint64_t pool_pa;
+	int32_t gmu_smr, gmu_cb, gpu_smr, gpu_cb;
+	uint32_t wptr;			/* ring write pointer, dwords */
+	uint32_t fence;			/* last fence value submitted */
+	uint32_t hfi_seq;
+	uint32_t pt_next;		/* next free table in the arena */
+};
+
+/* ---- environment ---- */
+uint32_t a6_rd(uint64_t pa);
+void a6_wr(uint64_t pa, uint32_t v);
+int a6_write(uint64_t pa, const void *buf, size_t len);	/* DRAM: any size; MMIO: words */
+int a6_read(uint64_t pa, void *buf, size_t len);
+void a6_delay_ms(unsigned ms);
+void a6_log(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+void a6_smc(uint64_t x[8]);				/* x0..x7 in, x0..x3 out */
+const uint8_t *a6_firmware(const char *name, uint32_t *len);	/* NULL if missing */
+
+/* ---- core ---- */
+static inline uint64_t a6_pool_pa(const struct a6_gpu *g, uint64_t off) { return g->pool_pa + off; }
+static inline uint64_t a6_pool_va(uint64_t off) { return A6_GVA_POOL + off; }
+
+/* /reserved-memory/pil_gpu_region as the bootloader actually placed it. ABL
+ * rebases the whole pil_* group by 4 MiB at boot, so the value in the static
+ * DTB (0x98715000) is not the one TZ/SCM will validate against: the shim reads
+ * the live tree and passes it on as sweetzap=. */
+void a6_set_zap_region(uint64_t pa, uint32_t size);
+void a6_set_zap_enable(int on);
+
+/* Phase gate for bring-up: -1 = run everything, 0 = stop before the pool work,
+ * 1..4 = stop after CX / GMU boot / HFI / CP. Set from sweeta6xx_stop=N. */
+extern int a6_stop_phase;
+
+/*
+ * Where bring-up is, readable from another thread. Filming the panel is the
+ * only way to read this phone's console, and a bring-up that wedges inside an
+ * MMIO access prints nothing at all, so the kernel environment starts a
+ * watchdog: it waits sweeta6xx_wd= seconds (default 45), and if a6_core_done
+ * is still false it panics with these two values. One boot, one photo of the
+ * panic screen, and the stall is named.
+ */
+extern volatile int a6_core_phase;		/* 0 = not started, 1..4 = in that phase, 5 = done */
+extern volatile const char *a6_core_step;	/* last named step reached */
+extern volatile int a6_core_done;		/* 1 = bring-up returned (success or failure) */
+void a6_mark(const char *step);			/* record + log one step */
+
+void a6_init_state(struct a6_gpu *g, uint64_t pool_pa);
+int a6_power_up(struct a6_gpu *g);	/* everything up to a working CP with the zap shader; 0 = ok */
+bool a6_cx_up(void);
+bool a6_gx_up(void);
+bool a6_cp_running(const struct a6_gpu *g);	/* GX on and the CP runs our SQE */
+
+uint32_t a6_pkt7(uint32_t op, uint32_t cnt);
+uint32_t a6_pkt4(uint32_t reg, uint32_t cnt);
+
+/* Queue dwords into the ring, move WPTR, wait for rptr == wptr and !busy. what: log label or NULL. */
+int a6_ring(struct a6_gpu *g, const uint32_t *dw, uint32_t n, const char *what, unsigned timeout_ms);
+/* IB at iova, then WFI + fence write; waits for the fence. 0 = ok. */
+int a6_submit_ib(struct a6_gpu *g, uint64_t iova, uint32_t dwords, unsigned timeout_ms);
+uint32_t a6_fence_read(const struct a6_gpu *g);
+
+/* 4K pages (AP=01, NC) at iova -> pa; tables from the arena. Then a6_tlb_flush. */
+int a6_map(struct a6_gpu *g, uint64_t iova, uint64_t pa, uint64_t size);
+int a6_map_pages(struct a6_gpu *g, uint64_t iova, const uint64_t *pages, uint32_t npages, uint32_t page_size);
+void a6_unmap_high(struct a6_gpu *g);	/* drop all mappings above 1 GB, reset the arena */
+void a6_tlb_flush(const struct a6_gpu *g);
+int a6_clear_fault(const struct a6_gpu *g);	/* 1 if an SMMU fault was cleared */
+uint32_t a6_fault_status(const struct a6_gpu *g, uint64_t *far, uint32_t *fsynr0);
+
+/*
+ * Scaled, filtered 2D blit (the one Mesa's turnip emits for vkCmdBlitImage
+ * on the A640, work/gpu/cap-blit): BGRA8 linear -> BGRA8 linear, pitches
+ * multiples of 64 bytes. Writes the IB into dw (A6_BLIT_MAX_DW) and returns
+ * its length.
+ */
+struct a6_blit {
+	uint64_t src_iova;
+	uint32_t src_w, src_h, src_pitch;
+	uint32_t sx, sy, sw, sh;		/* source rectangle */
+	uint64_t dst_iova;
+	uint32_t dst_pitch;
+	uint32_t dx, dy, dw, dh;		/* destination rectangle */
+	bool filter;				/* bilinear */
+};
+#define A6_BLIT_MAX_DW	256
+uint32_t a6_blit_ib(const struct a6_gpu *g, const struct a6_blit *b, uint32_t *dw);
+
+#define A6_CP_NOP		0x10
+#define A6_CP_WAIT_FOR_IDLE	0x26
+#define A6_CP_BLIT		0x2c
+#define A6_CP_MEM_WRITE		0x3d
+#define A6_CP_INDIRECT_BUFFER	0x3f
+#define A6_CP_EVENT_WRITE	0x46
+#define A6_CP_ME_INIT		0x48
+#define A6_CP_SET_SECURE_MODE	0x66
+#define A6_CP_MEMCPY		0x75
+
+/* Register/state access for status and dumps */
+#define A6_GPU_BASE		0x02c00000ull
+#define A6_GREG(o)		(A6_GPU_BASE + 4ull * (o))
+#define A6_GPUCC		0x02c90000ull
+#define A6_SMMU			0x02ca0000ull
+#define A6_SMMU_CB(n)		(A6_SMMU + 0x8000 + 0x1000ull * (n))
+#define A6_FSR_FAULT		0xc00001feu
+#define A6_GMEM_LOG_OFF		0x91000ull
+#define A6_GMU_LOG_VA		0x60001000u
+#define A6_GMU_LOG_SIZE		0x4000u
+
+#endif
+
diff --git a/bsd/dev/sweet_a6xx.c b/bsd/dev/sweet_a6xx.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_a6xx.c
@@ -0,0 +1,1154 @@
+/*
+ * Adreno 640 core (see sweet_a6xx.h). The bring-up follows shim/gpuprobe.c,
+ * which first worked on the phone; that file has the reasoning behind each
+ * register value (offsets from mainline a6xx_gmu.c/a6xx_gpu.c, a6xx.xml,
+ * gpucc-sm8150.c, sm8150.dtsi).
+ */
+#if !defined(KERNEL) || defined(ARM64_BOARD_CONFIG_SWEET)
+#ifdef KERNEL
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/debug.h>
+#include <libkern/libkern.h>
+#else
+#include <string.h>
+#endif
+#include "sweet_a6xx.h"
+
+#define rd32		a6_rd
+#define wr32		a6_wr
+
+/* ---- progress markers (see sweet_a6xx.h) ---- */
+
+volatile int a6_core_phase;
+volatile const char *a6_core_step = "core:start";
+volatile int a6_core_done;
+
+void
+a6_mark(const char *step)
+{
+	a6_core_step = step;
+	a6_log("step: %s\n", step);
+}
+
+static void wr64(uint64_t pa, uint64_t v)
+{
+	wr32(pa, (uint32_t)v);
+	wr32(pa + 4, (uint32_t)(v >> 32));
+}
+
+static int wait_bit(uint64_t pa, uint32_t mask, int set, unsigned ms)
+{
+	for (unsigned i = 0; i <= ms; i++) {
+		if (!!(rd32(pa) & mask) == set)
+			return 0;
+		if (i < ms)
+			a6_delay_ms(1);
+	}
+	return -1;
+}
+
+static void zero_pa(uint64_t pa, uint64_t size)
+{
+	static const uint8_t z[0x4000];
+	for (uint64_t o = 0; o < size; o += sizeof(z))
+		a6_write(pa + o, z, (size_t)(size - o < sizeof(z) ? size - o : sizeof(z)));
+}
+
+/* ---- registers ---- */
+
+#define GCC		0x00100000ull
+#define GPUCC		A6_GPUCC
+#define GPU		A6_GPU_BASE
+#define GREG(o)		A6_GREG(o)
+#define GMU_REG(o)	A6_GREG(o)
+#define SMMU		A6_SMMU
+
+#define GPUCC_CX_GDSCR	0x106c
+#define GPUCC_GX_GDSCR	0x100c
+#define GPUCC_GMU_RCG	0x1120
+#define GPUCC_AHB	0x1078
+#define GPUCC_CXO	0x109c
+#define GPUCC_CX_GMU	0x1098
+
+#define GMU_ITCM	0x1b400
+#define GMU_DTCM	0x1c400
+#define GMU_FW_VERSION	0x1d3f8
+#define GMU_INIT_RESULT	0x1f81c
+#define GMU_RPMH_STATE	0x1f8ec
+#define GMU_GENERAL_7	0x1f9cc
+#define GMU_CX_BUSY	0x23b0c
+
+#define SMMU_GR1	(SMMU + 0x1000)
+#define SMMU_CB(n)	A6_SMMU_CB(n)
+#define SMR(n)		(SMMU + 0x800 + 4 * (n))
+#define S2CR(n)		(SMMU + 0xc00 + 4 * (n))
+#define CBAR(n)		(SMMU_GR1 + 4 * (n))
+#define CBA2R(n)	(SMMU_GR1 + 0x800 + 4 * (n))
+#define CB_SCTLR	0x00
+#define CB_TCR2		0x10
+#define CB_TTBR0	0x20
+#define CB_TCR		0x30
+#define CB_MAIR0	0x38
+#define CB_FSR		0x58
+#define CB_FAR		0x60
+#define CB_FSYNR0	0x68
+#define CB_TLBIALL	0x618
+#define CB_TLBSYNC	0x7f0
+#define CB_TLBSTATUS	0x7f4
+/*
+ * TCR2: 40-bit PA, SEP = 7 (upstream bus size). SEP 0 (the reset value)
+ * makes VA bit 31 select TTBR1, which is off: every GPU VA >= 2 GB faulted
+ * at level 0. Linux's arm-smmu sets SEP_UPSTREAM too.
+ */
+#define TCR2_VAL	((7u << 15) | 2u)
+
+#define GMU_SID		5
+#define GMU_SID_MASK	0x400
+#define GPU_SID		0
+#define GPU_SID_MASK	0x401
+
+#define GMEM_L1(g)	a6_pool_pa(g, 0x0000)
+#define GMEM_L2_0(g)	a6_pool_pa(g, 0x1000)
+#define GMEM_L2_1(g)	a6_pool_pa(g, 0x2000)
+#define GMEM_L3_LOW(g)	a6_pool_pa(g, 0x3000)
+#define GMEM_L3_6(g)	a6_pool_pa(g, 0x4000)
+#define GMEM_ICACHE(g)	a6_pool_pa(g, 0x10000)
+#define GMEM_DCACHE(g)	a6_pool_pa(g, 0x50000)
+#define GMEM_DUMMY(g)	a6_pool_pa(g, 0x90000)
+#define GMEM_LOG(g)	a6_pool_pa(g, A6_GMEM_LOG_OFF)
+#define GMEM_HFI(g)	a6_pool_pa(g, 0x95000)
+
+#define VA_ICACHE	0x4000u
+#define VA_DCACHE	0x44000u
+#define CACHE_SIZE	0x3c000u
+#define VA_DUMMY	0x60000000u
+#define VA_LOG		A6_GMU_LOG_VA
+#define VA_HFI		0x60005000u
+
+#define RSCC		(0x02c6a000ull + 0x23000)
+#define RSCC_REG(o)	(RSCC + 4ull * (o))
+#define PDC		0x0b290000ull
+#define PDC_REG(o)	(PDC + 4ull * (o))
+#define PDC_SEQ		0x0b490000ull
+
+#define GMU_SYSRESET	0x1f800
+#define GMU_BOOT_CFG	0x1f801
+#define GMU_CM3_CFG	0x1f82d
+#define GMU_PWRCOL_CTRL	0x1f8c0
+#define GMU_RPMH_CTRL	0x1f8e8
+#define GMU_CP_MSG	0x1f900
+#define GMU_CP_RESP	0x1f901
+#define GMU_HFI_CTRL	0x1f980
+#define GMU_SFR_ADDR	0x1f982
+#define GMU_QTBL_INFO	0x1f984
+#define GMU_QTBL_ADDR	0x1f985
+#define GMU_SYS_BUS	0x1f40f
+#define GMU_ICACHE_CFG	0x1f400
+#define GMU_DCACHE_CFG	0x1f401
+#define GMU_RSCC_REQ	0x23b07
+#define GMU_RSCC_ACK	0x23b08
+#define GMU_FENCE0	0x23b11
+#define GMU_G2H_CLR	0x1f991
+#define GMU_G2H_INFO	0x1f992
+#define GMU_H2G_SET	0x1f994
+
+#define RBBM_STATUS		0x210
+#define RBBM_INT_STATUS		0x201
+#define CP_RB_BASE		0x800
+#define CP_RB_CNTL		0x802
+#define CP_RB_RPTR		0x806
+#define CP_RB_WPTR		0x807
+#define CP_SQE_CNTL		0x808
+#define CP_HW_FAULT		0x821
+#define CP_STATUS_1		0x825
+#define CP_SQE_INSTR_BASE	0x830
+
+static bool is_on(uint64_t gdscr)
+{
+	return (rd32(gdscr) >> 31) & 1;
+}
+
+static bool clk_on(uint64_t cbcr)
+{
+	return !(rd32(cbcr) >> 31);	/* CLK_OFF */
+}
+
+bool a6_cx_up(void)
+{
+	return is_on(GPUCC + GPUCC_CX_GDSCR) && clk_on(GPUCC + GPUCC_AHB) && clk_on(GPUCC + GPUCC_CX_GMU);
+}
+
+bool a6_gx_up(void)
+{
+	return a6_cx_up() && is_on(GPUCC + GPUCC_GX_GDSCR);
+}
+
+bool a6_cp_running(const struct a6_gpu *g)
+{
+	return a6_gx_up() && rd32(GREG(CP_SQE_INSTR_BASE)) == (uint32_t)a6_pool_va(A6_OFF_SQE) && g->gpu_cb >= 0;
+}
+
+void a6_init_state(struct a6_gpu *g, uint64_t pool_pa)
+{
+	memset(g, 0, sizeof(*g));
+	g->pool_pa = pool_pa;
+	g->gmu_smr = g->gmu_cb = g->gpu_smr = g->gpu_cb = -1;
+}
+
+/* ---- stage 1: clocks and CX power ---- */
+
+static void branch_on(const char *name, uint64_t reg)
+{
+	wr32(reg, rd32(reg) | 1);
+	int rc = wait_bit(reg, 1u << 31, 0, 10);
+	a6_log("%s = %x%s\n", name, rd32(reg), rc ? " (still halted)" : "");
+}
+
+static int power_cx(void)
+{
+	a6_mark("cx:read");
+	a6_log("before: cx_gdsc %x gx_gdsc %x gmu_rcg %x/%x ahb %x cxo %x cx_gmu %x\n",
+	       rd32(GPUCC + GPUCC_CX_GDSCR), rd32(GPUCC + GPUCC_GX_GDSCR), rd32(GPUCC + GPUCC_GMU_RCG),
+	       rd32(GPUCC + GPUCC_GMU_RCG + 4), rd32(GPUCC + GPUCC_AHB), rd32(GPUCC + GPUCC_CXO),
+	       rd32(GPUCC + GPUCC_CX_GMU));
+	a6_mark("cx:gcc-branches");
+	branch_on("gcc gpu_cfg_ahb", GCC + 0x71004);
+	branch_on("gcc ddrss_gpu_axi", GCC + 0x71154);
+	branch_on("gcc gpu_memnoc_gfx", GCC + 0x7100c);
+	branch_on("gcc gpu_snoc_dvm_gfx", GCC + 0x71018);
+
+	a6_mark("cx:gdsc");
+	uint64_t gdsc = GPUCC + GPUCC_CX_GDSCR;
+	wr32(gdsc, rd32(gdsc) & ~1u);
+	int rc = wait_bit(gdsc, 1u << 31, 1, 100);
+	a6_log("cx gdsc -> %x %s\n", rd32(gdsc), rc ? "TIMEOUT" : "on");
+	if (rc)
+		return -1;
+
+	a6_mark("cx:gmu-rcg");
+	uint64_t rcg = GPUCC + GPUCC_GMU_RCG;
+	wr32(rcg + 4, (rd32(rcg + 4) & ~0x71fu) | 1u);
+	wr32(rcg, rd32(rcg) | 1u);
+	rc = wait_bit(rcg, 1, 0, 10);
+	a6_log("gmu rcg %x cfg %x %s\n", rd32(rcg), rd32(rcg + 4), rc ? "UPDATE TIMEOUT" : "");
+
+	a6_mark("cx:gpucc-branches");
+	branch_on("gpucc ahb", GPUCC + GPUCC_AHB);
+	branch_on("gpucc cxo", GPUCC + GPUCC_CXO);
+	branch_on("gpucc cx_gmu", GPUCC + GPUCC_CX_GMU);
+	a6_mark("cx:mhz-read");
+	if (!a6_cx_up())
+		return -1;
+	a6_log("gmu fw_version %x init_result %x rpmh_state %x; smmu idr0 %x\n",
+	       rd32(GMU_REG(GMU_FW_VERSION)), rd32(GMU_REG(GMU_INIT_RESULT)), rd32(GMU_REG(GMU_RPMH_STATE)),
+	       rd32(SMMU + 0x20));
+	return 0;
+}
+
+/* ---- SMMU ---- */
+
+/* 4K pages for the GMU windows; priv: AP=00 (GMU code), else AP=01. */
+static void map_gmu_pages(uint64_t l3, uint32_t va, uint64_t pa, uint32_t size, int priv)
+{
+	for (uint32_t o = 0; o < size; o += 0x1000) {
+		uint32_t idx = ((va + o) >> 12) & 0x1ff;
+		wr64(l3 + 8 * idx, (pa + o) | (1u << 10) | (3u << 8) | (priv ? 0 : (1u << 6)) | 3u);
+	}
+}
+
+/* T0SZ: 32 (4 GB) for the GMU, 25 (39-bit) for the GPU; walks start at level 1 either way. */
+static void smmu_bank(int smr, int cb, uint64_t ttbr0, uint32_t sid, uint32_t mask)
+{
+	uint32_t t0sz = sid == GPU_SID ? 25 : 32;
+	uint64_t c = SMMU_CB(cb);
+	wr32(c + CB_SCTLR, 0);
+	wr32(CBA2R(cb), 1);					/* AArch64 descriptors */
+	wr32(CBAR(cb), (1u << 16) | (0xfu << 12) | (3u << 8) | (uint32_t)(cb + 1));
+	wr32(c + CB_TCR2, TCR2_VAL);
+	wr64(c + CB_TTBR0, ttbr0);
+	wr32(c + CB_TCR, t0sz | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23));
+	wr32(c + CB_MAIR0, 0x0000ff44);
+	wr32(c + CB_FSR, 0xffffffff);
+	wr32(c + CB_SCTLR, 1 | 2 | 4 | 0x20 | 0x40);		/* M TRE AFE CFRE CFIE */
+	wr32(SMMU + 0x68, 0);					/* TLBIALLNSNH */
+	wr32(SMMU + 0x70, 0);					/* TLBGSYNC */
+	wait_bit(SMMU + 0x74, 1, 0, 10);
+	wr32(S2CR(smr), (uint32_t)cb);
+	wr32(SMR(smr), (1u << 31) | (mask << 16) | sid);
+	a6_log("smmu: smr%d %x -> cb%d cbar %x sctlr %x tcr %x tcr2 %x\n", smr, rd32(SMR(smr)), cb,
+	       rd32(CBAR(cb)), rd32(c + CB_SCTLR), rd32(c + CB_TCR), rd32(c + CB_TCR2));
+}
+
+static int smmu_pick(int32_t *smr_out, int32_t *cb_out, int cb_min)
+{
+	int smr = -1, cb = -1;
+	uint32_t used_cb = 0;
+	for (int i = 0; i < 6; i++) {
+		uint32_t m = rd32(SMR(i)), c = rd32(S2CR(i));
+		if ((m >> 31) && ((c >> 16) & 3) == 0)
+			used_cb |= 1u << (c & 0xff);
+		if (smr < 0 && !(m >> 31))
+			smr = i;
+	}
+	for (int i = cb_min; i < 5; i++)
+		if (cb < 0 && !(used_cb & (1u << i)) && !(rd32(SMMU_CB(i) + CB_SCTLR) & 1))
+			cb = i;
+	*smr_out = smr;
+	*cb_out = cb;
+	return smr < 0 || cb < 0 ? -1 : 0;
+}
+
+void a6_tlb_flush(const struct a6_gpu *g)
+{
+	uint64_t c = SMMU_CB(g->gpu_cb);
+	wr32(c + CB_TLBIALL, 0);
+	wr32(c + CB_TLBSYNC, 0);
+	wait_bit(c + CB_TLBSTATUS, 1, 0, 10);
+}
+
+uint32_t a6_fault_status(const struct a6_gpu *g, uint64_t *far, uint32_t *fsynr0)
+{
+	if (g->gpu_cb < 0)
+		return 0;
+	uint64_t c = SMMU_CB(g->gpu_cb);
+	if (far)
+		*far = rd32(c + CB_FAR) | ((uint64_t)rd32(c + CB_FAR + 4) << 32);
+	if (fsynr0)
+		*fsynr0 = rd32(c + CB_FSYNR0);
+	return rd32(c + CB_FSR) & A6_FSR_FAULT;
+}
+
+/*
+ * A translation fault blocks the GPU's later writes (the fence never lands)
+ * until the context bank's FSR is cleared; clearing it is enough to go on.
+ */
+int a6_clear_fault(const struct a6_gpu *g)
+{
+	uint64_t far;
+	uint32_t syn, fsr = a6_fault_status(g, &far, &syn);
+	if (!fsr)
+		return 0;
+	a6_log("clearing smmu cb%d fault: fsr %x far %llx fsynr0 %x\n", g->gpu_cb, fsr,
+	       (unsigned long long)far, syn);
+	wr32(SMMU_CB(g->gpu_cb) + CB_FSR, rd32(SMMU_CB(g->gpu_cb) + CB_FSR));
+	return 1;
+}
+
+/* ---- stage 2: GMU boot ---- */
+
+static int gmu_smmu(struct a6_gpu *g)
+{
+	if (smmu_pick(&g->gmu_smr, &g->gmu_cb, 0)) {
+		a6_log("smmu: no free smr/cb\n");
+		return -1;
+	}
+	zero_pa(g->pool_pa, 0x100000);
+	wr64(GMEM_L1(g) + 0, GMEM_L2_0(g) | 3);
+	wr64(GMEM_L1(g) + 8, GMEM_L2_1(g) | 3);
+	wr64(GMEM_L2_0(g) + 0, GMEM_L3_LOW(g) | 3);
+	wr64(GMEM_L2_1(g) + 8 * ((VA_DUMMY >> 21) & 0x1ff), GMEM_L3_6(g) | 3);
+	map_gmu_pages(GMEM_L3_LOW(g), VA_ICACHE, GMEM_ICACHE(g), CACHE_SIZE, 1);
+	map_gmu_pages(GMEM_L3_LOW(g), VA_DCACHE, GMEM_DCACHE(g), CACHE_SIZE, 1);
+	map_gmu_pages(GMEM_L3_6(g), VA_DUMMY, GMEM_DUMMY(g), 0x1000, 0);
+	map_gmu_pages(GMEM_L3_6(g), VA_LOG, GMEM_LOG(g), A6_GMU_LOG_SIZE, 0);
+	map_gmu_pages(GMEM_L3_6(g), VA_HFI, GMEM_HFI(g), 0x4000, 0);
+	smmu_bank(g->gmu_smr, g->gmu_cb, GMEM_L1(g), GMU_SID, GMU_SID_MASK);
+	return 0;
+}
+
+/* a6xx_gmu_rpmh_init for the A640 (pdc_address_offset 0x30090). */
+static void rpmh_init(void)
+{
+	static const uint32_t rscc[][2] = {
+		{ 0x0004, 1u << 24 }, { 0x000b, 1 }, { 0x000e, 0 }, { 0x000d, 0 }, { 0x0010, 0 }, { 0x000f, 0 },
+		{ 0x0012, 0x80000000 }, { 0x0011, 0 }, { 0x0100, 0 }, { 0x0008, 0x4520 }, { 0x0009, 0x4510 },
+		{ 0x000a, 0x4514 }, { 0x0180, 0xa7a506a0 }, { 0x0181, 0xa1e6a6e7 }, { 0x0182, 0xa2e081e1 },
+		{ 0x0183, 0xe9a982e2 }, { 0x0184, 0x0020e8a8 },
+	};
+	static const uint32_t seq[] = { 0xfebea1e1, 0xa5a4a3a2, 0x8382a6e0, 0xbce3e284, 0x002081fc };
+	static const uint32_t pdc[][2] = {
+		{ 0x1573, 7 }, { 0x1574, 0 }, { 0x1572, 0 }, { 0x1575, 0x10108 }, { 0x1576, 0x30010 },
+		{ 0x1577, 1 }, { 0x1579, 0x10108 }, { 0x157a, 0x30000 }, { 0x157b, 0 }, { 0x157d, 0x10108 },
+		{ 0x157e, 0x30090 }, { 0x157f, 0 },
+		{ 0x15d7, 7 }, { 0x15d8, 0 }, { 0x15d6, 0 }, { 0x15d9, 0x10108 }, { 0x15da, 0x30010 },
+		{ 0x15db, 2 }, { 0x15dd, 0x10108 }, { 0x15de, 0x30000 }, { 0x15df, 3 }, { 0x15e1, 0x10108 },
+		{ 0x15e2, 0x30090 }, { 0x15e3, 3 },
+		{ 0x1148, 0 }, { 0x1140, 0x80000001 },
+	};
+	for (unsigned i = 0; i < sizeof(rscc) / sizeof(rscc[0]); i++)
+		wr32(RSCC_REG(rscc[i][0]), rscc[i][1]);
+	for (unsigned i = 0; i < sizeof(seq) / sizeof(seq[0]); i++)
+		wr32(PDC_SEQ + 4 * i, seq[i]);
+	for (unsigned i = 0; i < sizeof(pdc) / sizeof(pdc[0]); i++)
+		wr32(PDC_REG(pdc[i][0]), pdc[i][1]);
+}
+
+static void hfi_table(struct a6_gpu *g)
+{
+	uint64_t t = GMEM_HFI(g);
+	wr32(t + 0, 0);
+	wr32(t + 4, 6 * 4 + 3 * 12 * 4);
+	wr32(t + 8, 6);
+	wr32(t + 12, 12);
+	wr32(t + 16, 3);
+	wr32(t + 20, 3);
+	for (uint32_t q = 0; q < 3; q++) {
+		uint64_t h = t + 24 + 48 * q;
+		wr32(h + 0, 1);
+		wr32(h + 4, VA_HFI + 0x1000 * (q + 1));
+		wr32(h + 8, (10u << 8) | q);
+		wr32(h + 12, 0x1000 >> 2);
+		wr32(h + 24, 1);
+		wr32(h + 28, 1);
+		wr32(h + 32, 1);
+	}
+}
+
+static int fw_load(struct a6_gpu *g)
+{
+	uint32_t len;
+	const uint8_t *fw = a6_firmware("a640_gmu.bin", &len);
+	if (!fw)
+		return -1;
+	const uint8_t *p = fw, *end = fw + len;
+	int n = 0;
+	while (p + 16 <= end) {
+		uint32_t addr, size;
+		memcpy(&addr, p, 4);
+		memcpy(&size, p + 4, 4);
+		const uint8_t *data = p + 16;
+		uint64_t dst = 0;
+		if (addr < 0x4000)
+			dst = GMU_REG(GMU_ITCM) + addr;
+		else if (addr >= 0x40000 && addr < 0x44000)
+			dst = GMU_REG(GMU_DTCM) + (addr - 0x40000);
+		else if (addr >= VA_ICACHE && addr + size <= VA_ICACHE + CACHE_SIZE)
+			dst = GMEM_ICACHE(g) + (addr - VA_ICACHE);
+		else if (addr >= VA_DCACHE && addr + size <= VA_DCACHE + CACHE_SIZE)
+			dst = GMEM_DCACHE(g) + (addr - VA_DCACHE);
+		if (!dst || data + size > end) {
+			a6_log("gmu fw: bad block %x size %x\n", addr, size);
+			return -1;
+		}
+		a6_write(dst, data, (size + 3) & ~3u);
+		p = data + size;
+		n++;
+	}
+	return n;
+}
+
+static int gmu_boot(struct a6_gpu *g)
+{
+	a6_mark("gmu:smmu");
+	if (gmu_smmu(g))
+		return -1;
+	a6_mark("gmu:rpmh");
+	rpmh_init();
+	a6_mark("gmu:hfi-table");
+	hfi_table(g);
+
+	a6_mark("gmu:rscc");
+	wr32(GMU_REG(GMU_GENERAL_7), 1);
+	wr32(GMU_REG(GMU_RSCC_REQ), 1u << 1);
+	(void)wait_bit(GMU_REG(GMU_RSCC_ACK), 1u << 1, 1, 200);	/* never acks; harmless */
+	(void)wait_bit(RSCC_REG(0x0101), 0xffffffff, 0, 10);
+	wr32(GMU_REG(GMU_RSCC_REQ), 0);
+
+	a6_mark("gmu:fw-load");
+	int nblk = fw_load(g);
+	a6_log("gmu: %d firmware blocks loaded\n", nblk);
+	if (nblk <= 0)
+		return -1;
+
+	a6_mark("gmu:kick");
+	wr32(GMU_REG(GMU_INIT_RESULT), 0);
+	wr32(GMU_REG(GMU_BOOT_CFG), 2);
+	wr32(GMU_REG(GMU_QTBL_ADDR), VA_HFI);
+	wr32(GMU_REG(GMU_QTBL_INFO), 1);
+	wr32(GMU_REG(GMU_FENCE0), (1u << 31) | (0xau << 18) | 0xa0);
+	wr32(GMU_REG(GMU_CM3_CFG), 0x4052);
+	wr32(GMU_REG(GMU_SFR_ADDR), 0x06040100);
+	for (uint32_t i = 0; i < 4; i++)
+		wr32(GPU + 4 * (0x3c03 + i), 0x00071620);
+	wr32(GMU_REG(GMU_CP_MSG), VA_LOG | (A6_GMU_LOG_SIZE / 0x1000 - 1));
+	wr32(GMU_REG(GMU_SYS_BUS), 1);
+	wr32(GMU_REG(GMU_ICACHE_CFG), 1);
+	wr32(GMU_REG(GMU_DCACHE_CFG), 1);
+	wr32(GMU_REG(GMU_PWRCOL_CTRL), 0x9c40400);
+	wr32(GMU_REG(GMU_RPMH_CTRL), rd32(GMU_REG(GMU_RPMH_CTRL)) |
+	     1 | (1u << 4) | (1u << 8) | (1u << 9) | (1u << 10) | (1u << 11));
+
+	uint32_t v = rd32(GMU_REG(GMU_DTCM) + 0xff8 * 4);
+	uint32_t mask = v <= 0x20010004 ? 0xffffffff : 0x1ff;
+	uint32_t want = v <= 0x20010004 ? 0xbabeface : 0x100;
+	wr32(GMU_REG(GMU_SYSRESET), 1);
+	wr32(GMU_REG(GMU_CP_RESP), 0);
+	wr32(GMU_REG(GMU_SYSRESET), 0);
+	a6_mark("gmu:poll-init");
+	uint32_t r = 0;
+	bool ok = false;
+	for (int i = 0; i < 2000 && !ok; i++) {
+		r = rd32(GMU_REG(GMU_INIT_RESULT));
+		ok = (r & mask) == want;
+		if (!ok)
+			a6_delay_ms(1);
+	}
+	a6_log("gmu: init result %x %s, hfi_ctrl %x\n", r, ok ? "BOOTED" : "timeout", rd32(GMU_REG(GMU_HFI_CTRL)));
+	return ok ? 0 : -1;
+}
+
+/* ---- stage 3: HFI, GX power ---- */
+
+#define HFI_Q_CMD	0
+#define HFI_Q_RESP	1
+#define QHDR(g, q)	(GMEM_HFI(g) + 24 + 48 * (q))
+#define QDATA(g, q)	(GMEM_HFI(g) + 0x1000 * ((q) + 1))
+#define QSIZE		1024
+
+#define LVL_MIN_SVS	48
+#define LVL_LOW_SVS	64
+#define LVL_SVS		128
+#define LVL_SVS_L1	192
+#define LVL_SVS_L2	224
+#define LVL_NOM		256
+
+static const uint32_t gpu_khz[] = { 0, 257000, 345000, 427000, 499200, 585000 };
+static const uint32_t gpu_lvl[] = { 0, LVL_LOW_SVS, LVL_SVS, LVL_SVS_L1, LVL_SVS_L2, LVL_NOM };
+static const uint32_t gmu_khz[] = { 0, 200000 };
+static const uint32_t gmu_lvl[] = { 0, LVL_MIN_SVS };
+
+static int cmddb_aux(const char *id, uint64_t *aux, uint32_t *len)
+{
+	uint64_t db = rd32(0x0c3f000cull);
+	if (rd32(db + 4) != 0x0c0330db)
+		return -1;
+	uint64_t data = db + 4 + 4 + 8 * 16 + 4 + 4;
+	for (uint32_t r = 0; r < 8; r++) {
+		uint64_t rh = db + 8 + 16 * r;
+		uint32_t w0 = rd32(rh), w1 = rd32(rh + 4);
+		uint32_t hoff = w0 >> 16, doff = w1 & 0xffff, cnt = w1 >> 16;
+		for (uint32_t e = 0; e < cnt; e++) {
+			uint64_t ent = data + hoff + 24 * e;
+			char name[9];
+			for (uint32_t i = 0; i < 8; i++)
+				name[i] = (char)(rd32(ent + (i & ~3u)) >> (8 * (i & 3)));
+			name[8] = 0;
+			if (strncmp(name, id, 8))
+				continue;
+			uint32_t w5 = rd32(ent + 20);
+			*len = w5 & 0xffff;
+			*aux = data + doff + (w5 >> 16);
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static uint32_t aux16(uint64_t aux, uint32_t i)
+{
+	return (rd32(aux + 2 * (i & ~1u)) >> (16 * (i & 1))) & 0xffff;
+}
+
+static int arc_votes(uint32_t *votes, const uint32_t *lvl, int n, const char *pri_id, const char *sec_id)
+{
+	uint64_t pri, sec;
+	uint32_t plen, slen;
+	if (cmddb_aux(pri_id, &pri, &plen) || cmddb_aux(sec_id, &sec, &slen))
+		return -1;
+	plen /= 2;
+	slen /= 2;
+	for (int i = 0; i < n; i++) {
+		uint32_t pindex = 0, sindex = 0, j;
+		for (j = 0; j < plen; j++)
+			if (aux16(pri, j) >= lvl[i]) {
+				pindex = j;
+				break;
+			}
+		if (j == plen)
+			return -1;
+		for (j = 0; j < slen; j++) {
+			if (aux16(sec, j) >= lvl[i]) {
+				sindex = j;
+				break;
+			} else if (aux16(sec, j)) {
+				sindex = j;
+			}
+		}
+		votes[i] = (aux16(pri, pindex) << 16) | (sindex << 8) | pindex;
+	}
+	return 0;
+}
+
+static int hfi_send(struct a6_gpu *g, uint32_t id, uint32_t *msg, uint32_t dwords)
+{
+	uint32_t seq = ++g->hfi_seq;
+	a6_mark("hfi:send");
+	msg[0] = (seq << 20) | (dwords << 8) | id;
+	uint64_t h = QHDR(g, HFI_Q_CMD);
+	uint32_t w = rd32(h + 44);
+	for (uint32_t i = 0; i < dwords; i++) {
+		wr32(QDATA(g, HFI_Q_CMD) + 4 * w, msg[i]);
+		w = (w + 1) % QSIZE;
+	}
+	for (; w % 4; w = (w + 1) % QSIZE)
+		wr32(QDATA(g, HFI_Q_CMD) + 4 * w, 0xfafafafa);
+	wr32(h + 44, w);
+	wr32(GMU_REG(GMU_H2G_SET), 1);
+
+	for (int t = 0; t < 1000; t++) {
+		if (rd32(GMU_REG(GMU_G2H_INFO)) & 1) {
+			wr32(GMU_REG(GMU_G2H_CLR), 1);
+			uint64_t rh = QHDR(g, HFI_Q_RESP);
+			/* A malformed (zero length, 4-dword aligned) response would
+			 * leave r where it is and spin here forever; cap the drain. */
+			uint32_t drain = 0;
+			while (rd32(rh + 40) != rd32(rh + 44) && ++drain < 4 * QSIZE) {
+				uint32_t r = rd32(rh + 40), hdr = rd32(QDATA(g, HFI_Q_RESP) + 4 * r);
+				uint32_t n = (hdr >> 8) & 0xff, buf[24] = { 0 };
+				for (uint32_t i = 0; i < n && i < 24; i++) {
+					buf[i] = rd32(QDATA(g, HFI_Q_RESP) + 4 * r);
+					r = (r + 1) % QSIZE;
+				}
+				r = ((r + 3) & ~3u) % QSIZE;
+				wr32(rh + 40, r);
+				if ((hdr & 0xff) != 100 && (buf[1] >> 20) == seq)
+					return (int)buf[2];
+			}
+		}
+		a6_delay_ms(1);
+	}
+	a6_log("hfi: msg %u seq %u: no ack (info %x)\n", id, seq, rd32(GMU_REG(GMU_G2H_INFO)));
+	return -1;
+}
+
+static int gmu_hfi(struct a6_gpu *g)
+{
+	static uint32_t msg[256];
+	uint32_t gx[6], cx[2];
+	a6_mark("hfi:arc-votes");
+	if (arc_votes(gx, gpu_lvl, 6, "gfx.lvl", "mx.lvl") || arc_votes(cx, gmu_lvl, 2, "cx.lvl", "mx.lvl")) {
+		a6_log("hfi: cmd-db levels not found\n");
+		return -1;
+	}
+	memset(msg, 0, sizeof(msg));
+	msg[1] = 6;
+	msg[2] = 2;
+	for (int i = 0; i < 6; i++) {
+		msg[3 + 3 * i] = gx[i];
+		msg[4 + 3 * i] = 0xffffffff;
+		msg[5 + 3 * i] = gpu_khz[i];
+	}
+	for (int i = 0; i < 2; i++) {
+		msg[3 + 48 + 2 * i] = cx[i];
+		msg[4 + 48 + 2 * i] = gmu_khz[i];
+	}
+	int rc = hfi_send(g, 4, msg, 3 + 48 + 8);
+
+	a6_mark("hfi:ddr-table");
+	memset(msg, 0, sizeof(msg));
+	static const uint32_t bw[][2] = {
+		{ 1, 1 }, { 2, 3 }, { 3, 3 }, { 4, 1 }, { 5, 1 }, { 6, 0x50034 }, { 7, 0x5007c }, { 8, 0x5004c },
+		{ 12, 0x40000000 }, { 14, 0x40000000 }, { 18, 0x60000001 }, { 19, 0x20000001 }, { 20, 0x60000001 },
+		{ 24, 0x50000 }, { 25, 0x5003c }, { 26, 0x5000c }, { 32, 0x40000000 }, { 33, 0x40000000 },
+		{ 34, 0x40000000 },
+	};
+	for (unsigned i = 0; i < sizeof(bw) / sizeof(bw[0]); i++)
+		msg[bw[i][0]] = bw[i][1];
+	rc |= hfi_send(g, 3, msg, 32 + 128);
+	msg[1] = 0;
+	rc |= hfi_send(g, 14, msg, 2);
+	rc |= hfi_send(g, 10, msg, 1);
+	msg[1] = 1;
+	msg[2] = 1;			/* 257 MHz */
+	msg[3] = 0;
+	rc |= hfi_send(g, 30, msg, 4);
+	a6_log("hfi: perf/bw tables, core fw start, start, perf vote 257 MHz -> %d\n", rc);
+
+	wr32(GMU_REG(GMU_H2G_SET), 1u << 30);	/* OOB GPU_SET */
+	a6_mark("hfi:oob");
+	int ack = wait_bit(GMU_REG(GMU_G2H_INFO), 1u << 31, 1, 1000);
+	wr32(GMU_REG(GMU_G2H_CLR), 1u << 31);
+	a6_log("oob gpu_set %s, gx gdsc %x\n", ack ? "TIMEOUT" : "acked", rd32(GPUCC + GPUCC_GX_GDSCR));
+	a6_mark("hfi:gx-up");
+	if (!a6_gx_up()) {
+		a6_log("GX not powered; not touching GPU registers\n");
+		return -1;
+	}
+	return 0;
+}
+
+/* ---- zap shader through TrustZone PAS ---- */
+
+#define PAS_GPU		13
+/* Set from the live device tree by a6_set_zap_region() (see the header). The
+ * built-in value is only the static-DTB fallback and is wrong by 4 MiB on this
+ * board: ABL moves the pil_* carve-outs. */
+#define ZAP_FALLBACK	0x98b15000ull
+static uint64_t zap_region = ZAP_FALLBACK;
+static uint32_t zap_size = 0x2000u;
+static int zap_size_from_dtb;
+/* SCM from XNU is unproven on this board (the shim does it fine). Stage 1 of the
+ * kernel bring-up runs with this off so a bad SMC cannot cost the run. */
+static int zap_enable = 1;
+
+void
+a6_set_zap_enable(int on)
+{
+	zap_enable = on;
+}
+
+void
+a6_set_zap_region(uint64_t pa, uint32_t size)
+{
+	if (pa >= 0x10000000ull && size >= 0x1000u && size <= 0x100000u) {
+		zap_region = pa;
+		zap_size = size;
+		zap_size_from_dtb = 1;
+	}
+}
+#define SCM_PIL(cmd)	(0x42000000ull | (2u << 8) | (cmd))
+
+static int64_t scm(uint32_t cmd, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *r1)
+{
+	uint64_t x[8] = { SCM_PIL(cmd), arginfo, a, b, c, 0, 0, 0 };
+	a6_smc(x);
+	if (r1)
+		*r1 = x[1];
+	return (int64_t)x[0];
+}
+
+static int zap_load(struct a6_gpu *g)
+{
+	static uint8_t seg[0x10000];	/* .b02 is ~2 KB; the region is 8 KB */
+	uint64_t r1 = 0;
+	uint32_t mlen, slen;
+	const uint8_t *mdt = a6_firmware("a640_zap.mdt", &mlen), *b02 = a6_firmware("a640_zap.b02", &slen);
+	if (!mdt || !b02 || slen > sizeof(seg) || slen > zap_size)
+		return -1;
+	/*
+	 * SCM_PIL(INIT_IMAGE) takes a 32-bit physical address on this platform. The
+	 * pool sits above 4 GiB (0x184a00000 here), so passing pool+A6_OFF_ZAP_META
+	 * truncates and TrustZone rejects the image with rc 1, r1 0x82 - which is
+	 * exactly what the kernel logged while bare-metal shim-rmx (low memory)
+	 * authenticated the same blob. Put the metadata in the low zap region
+	 * instead (8 KB); TZ copies it during INIT_IMAGE, before .b02 is written
+	 * over the same region below.
+	 */
+	/* shim-rmx calls PAS_IS_SUPPORTED first and only then INIT_IMAGE; the kernel
+	 * driver went straight to cmd 1, which TrustZone answers with rc 1, r1 0x82. */
+	int64_t sup = scm(7, 1, PAS_GPU, 0, 0, &r1);
+	a6_log("zap: pas supported(13) rc %lld r1 %llx\n", (long long)sup, (unsigned long long)r1);
+	uint64_t meta_pa = zap_region;
+	a6_write(meta_pa, mdt, mlen);
+	a6_log("zap: meta %llx len %u (pool %llx low)\n", (unsigned long long)meta_pa,
+	    mlen, (unsigned long long)a6_pool_pa(g, A6_OFF_ZAP_META));
+	int64_t rc = scm(1, 2 | (2u << 6), PAS_GPU, meta_pa, 0, &r1);
+	if (rc || r1) {
+		a6_log("zap: init image rc %lld r1 %llx\n", (long long)rc, (unsigned long long)r1);
+		return -1;
+	}
+	rc = scm(2, 3, PAS_GPU, zap_region, zap_size, &r1);
+	if (rc || r1) {
+		a6_log("zap: mem setup rc %lld r1 %llx\n", (long long)rc, (unsigned long long)r1);
+		return -1;
+	}
+	memset(seg, 0, sizeof(seg));
+	memcpy(seg, b02, slen);
+	a6_write(zap_region, seg, zap_size);
+	rc = scm(5, 1, PAS_GPU, 0, 0, &r1);
+	a6_log("zap: region %llx size %x (%s)\n", (unsigned long long)zap_region,
+    zap_size, zap_size_from_dtb ? "live" : "fallback");
+	a6_log("zap: auth and reset rc %lld r1 %llx\n", (long long)rc, (unsigned long long)r1);
+	return rc || r1 ? -1 : 0;
+}
+
+/* ---- ring ---- */
+
+static uint32_t pm4_parity(uint32_t v)
+{
+	return (0x9669 >> (0xf & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^ (v >> 20) ^
+				  (v >> 24) ^ (v >> 28)))) & 1;
+}
+
+uint32_t a6_pkt7(uint32_t op, uint32_t cnt)
+{
+	return 0x70000000 | cnt | (pm4_parity(cnt) << 15) | ((op & 0x7f) << 16) | (pm4_parity(op) << 23);
+}
+
+uint32_t a6_pkt4(uint32_t reg, uint32_t cnt)
+{
+	return 0x40000000 | cnt | (pm4_parity(cnt) << 7) | ((reg & 0x3ffff) << 8) | (pm4_parity(reg) << 27);
+}
+
+int a6_ring(struct a6_gpu *g, const uint32_t *dw, uint32_t n, const char *what, unsigned timeout_ms)
+{
+	if (n >= A6_RING_DW)
+		return -1;
+	uint32_t w = g->wptr, first = n < A6_RING_DW - w ? n : A6_RING_DW - w;
+	a6_write(a6_pool_pa(g, A6_OFF_RING) + 4ull * w, dw, 4ull * first);
+	if (first < n)
+		a6_write(a6_pool_pa(g, A6_OFF_RING), dw + first, 4ull * (n - first));
+	g->wptr = (w + n) % A6_RING_DW;
+	wr32(GREG(CP_RB_WPTR), g->wptr);
+	unsigned i;
+	for (i = 0; i < timeout_ms * 10; i++) {
+		if (rd32(GREG(CP_RB_RPTR)) == g->wptr && !(rd32(GREG(RBBM_STATUS)) & (1u << 23)))
+			break;
+		if ((i & 7) == 7)
+			a6_delay_ms(1);
+	}
+	bool ok = i < timeout_ms * 10;
+	if (what || !ok)
+		a6_log("ring %s: rptr %x wptr %x status %x int %x hwfault %x cp_status1 %x %s\n",
+		       what ? what : "", rd32(GREG(CP_RB_RPTR)), g->wptr, rd32(GREG(RBBM_STATUS)),
+		       rd32(GREG(RBBM_INT_STATUS)), rd32(GREG(CP_HW_FAULT)), rd32(GREG(CP_STATUS_1)),
+		       ok ? "idle" : "TIMEOUT");
+	return ok ? 0 : -1;
+}
+
+uint32_t a6_fence_read(const struct a6_gpu *g)
+{
+	uint32_t v = 0;
+	a6_read(a6_pool_pa(g, A6_OFF_SCRATCH), &v, 4);
+	return v;
+}
+
+int a6_submit_ib(struct a6_gpu *g, uint64_t iova, uint32_t dwords, unsigned timeout_ms)
+{
+	uint64_t fva = a6_pool_va(A6_OFF_SCRATCH);
+	uint32_t fence = ++g->fence;
+	uint32_t dw[] = {
+		a6_pkt7(A6_CP_INDIRECT_BUFFER, 3), (uint32_t)iova, (uint32_t)(iova >> 32), dwords,
+		a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0),
+		a6_pkt7(A6_CP_MEM_WRITE, 3), (uint32_t)fva, (uint32_t)(fva >> 32), fence,
+	};
+	int rc = a6_ring(g, dw, sizeof(dw) / 4, NULL, timeout_ms);
+	return rc || a6_fence_read(g) != fence ? -1 : 0;
+}
+
+/* ---- GPU page tables ---- */
+
+static void map_gpu_low(struct a6_gpu *g)
+{
+	uint64_t l1 = a6_pool_pa(g, A6_OFF_GT_L1), l2 = a6_pool_pa(g, A6_OFF_GT_L2);
+	zero_pa(l1, 0x2000);
+	wr64(l1 + 0, l2 | 3);		/* VA 0-1 GB */
+	for (uint64_t o = 0; o < A6_POOL_SIZE; o += 0x200000)	/* AP=01, NC, 2 MB blocks */
+		wr64(l2 + 8 * (((A6_GVA_POOL + o) >> 21) & 0x1ff),
+		     (g->pool_pa + o) | (1u << 10) | (3u << 8) | (1u << 6) | 1u);
+	for (uint64_t o = 0; o < A6_FB_SIZE; o += 0x200000)
+		wr64(l2 + 8 * (((A6_GVA_FB + o) >> 21) & 0x1ff),
+		     (A6_FB_PA + o) | (1u << 10) | (3u << 8) | (1u << 6) | 1u);
+}
+
+static uint64_t pt_alloc(struct a6_gpu *g)
+{
+	uint64_t off = A6_OFF_PT_ARENA + 0x1000ull * g->pt_next;
+	if (off + 0x1000 > A6_OFF_SQE)
+		return 0;
+	g->pt_next++;
+	zero_pa(a6_pool_pa(g, off), 0x1000);
+	return a6_pool_pa(g, off);
+}
+
+static uint64_t pt_walk(struct a6_gpu *g, uint64_t table, unsigned idx)
+{
+	uint64_t e = 0;
+	a6_read(table + 8ull * idx, &e, 8);
+	if (e & 1)
+		return (e & 3) == 3 ? e & 0xfffffff000ull : 0;	/* 0: a block */
+	uint64_t t = pt_alloc(g);
+	if (t)
+		wr64(table + 8ull * idx, t | 3);
+	return t;
+}
+
+/* 4K entries for [iova, iova + n * 4K) taking the physical address of each 4K page from pa_of. */
+static int map_4k(struct a6_gpu *g, uint64_t iova, uint32_t n4k, uint64_t (*pa_of)(const void *, uint32_t),
+		  const void *arg)
+{
+	static uint64_t pte[512];
+	uint64_t l1 = a6_pool_pa(g, A6_OFF_GT_L1);
+	for (uint32_t i = 0; i < n4k;) {
+		uint64_t va = iova + 0x1000ull * i;
+		uint64_t l2 = pt_walk(g, l1, (va >> 30) & 0x1ff);
+		uint64_t l3 = l2 ? pt_walk(g, l2, (va >> 21) & 0x1ff) : 0;
+		if (!l3) {
+			a6_log("map: no page table for %llx (arena full, or a block there)\n", (unsigned long long)va);
+			return -1;
+		}
+		unsigned first = (va >> 12) & 0x1ff, k = 0;
+		while (first + k < 512 && i < n4k)
+			pte[k++] = pa_of(arg, i++) | (1u << 10) | (3u << 8) | (1u << 6) | 3u;
+		a6_write(l3 + 8ull * first, pte, 8ull * k);
+	}
+	return 0;
+}
+
+static uint64_t linear_pa(const void *arg, uint32_t i)
+{
+	return *(const uint64_t *)arg + 0x1000ull * i;
+}
+
+int a6_map(struct a6_gpu *g, uint64_t iova, uint64_t pa, uint64_t size)
+{
+	return map_4k(g, iova, (uint32_t)((size + 0xfff) >> 12), linear_pa, &pa);
+}
+
+struct page_list {
+	const uint64_t *pages;
+	uint32_t shift;		/* log2(page_size / 4K) */
+};
+
+static uint64_t list_pa(const void *arg, uint32_t i)
+{
+	const struct page_list *l = arg;
+	return l->pages[i >> l->shift] + 0x1000ull * (i & ((1u << l->shift) - 1));
+}
+
+int a6_map_pages(struct a6_gpu *g, uint64_t iova, const uint64_t *pages, uint32_t npages, uint32_t page_size)
+{
+	struct page_list l = { pages, 0 };
+	while ((0x1000u << l.shift) < page_size)
+		l.shift++;
+	return map_4k(g, iova, npages << l.shift, list_pa, &l);
+}
+
+void a6_unmap_high(struct a6_gpu *g)
+{
+	static const uint64_t zeros[511];
+	a6_write(a6_pool_pa(g, A6_OFF_GT_L1) + 8, zeros, sizeof(zeros));
+	g->pt_next = 0;
+	/* Banks set up before 39-bit iovas were needed had T0SZ 32 and SEP 0. */
+	uint64_t c = SMMU_CB(g->gpu_cb);
+	wr32(c + CB_TCR, 25 | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23));
+	wr32(c + CB_TCR2, TCR2_VAL);
+	a6_tlb_flush(g);
+}
+
+/* ---- stage 4: GPU SMMU bank, hw_init, SQE, CP ---- */
+
+static int gpu_cp(struct a6_gpu *g)
+{
+	a6_mark("cp:smmu-bank");
+	if (smmu_pick(&g->gpu_smr, &g->gpu_cb, g->gmu_cb + 1)) {
+		a6_log("smmu: no free smr/cb for the GPU\n");
+		return -1;
+	}
+	map_gpu_low(g);
+	smmu_bank(g->gpu_smr, g->gpu_cb, a6_pool_pa(g, A6_OFF_GT_L1), GPU_SID, GPU_SID_MASK);
+
+	/* a6xx hw_init for the A640 (a6xx_gpu.c), minus clock gating, CP protection and interrupts */
+	a6_mark("cp:hw-init");
+	wr32(GREG(0x3c45), 0);			/* GBIF_HALT */
+	(void)rd32(GREG(0x3c45));
+	wr32(GREG(0x16), 0);			/* RBBM_GBIF_HALT */
+	(void)rd32(GREG(0x16));
+	static const uint32_t init[][2] = {
+		{ 0xf803, 0 }, { 0xf800, 0 }, { 0xf801, 0 }, { 0xf802, 0 },	/* SECVID TSB */
+		/* 64-bit addressing: CP VSC GRAS RB PC HLSQ VFD VPC UCHE SP TPL1 SECVID */
+		{ 0x0842, 1 }, { 0x0c01, 1 }, { 0x8601, 1 }, { 0x8e05, 1 }, { 0x9e01, 1 }, { 0xbe05, 1 },
+		{ 0xa601, 1 }, { 0x9601, 1 }, { 0x0e00, 1 }, { 0xae01, 1 }, { 0xb601, 1 }, { 0xf810, 1 },
+		{ 0x0011, 3 },				/* RBBM_GBIF_CLIENT_QOS_CNTL */
+		{ 0x050b, 0xffffffff },			/* RBBM_PERFCTR_GPU_BUSY_MASKED */
+		/* UCHE: write range max, trap base, write-through base (trap 0x1fffffffff000) */
+		{ 0x0e05, 0xffffffc0 }, { 0x0e06, 0x1ffff }, { 0x0e09, 0xfffff000 }, { 0x0e0a, 0x1ffff },
+		{ 0x0e07, 0xfffff000 }, { 0x0e08, 0x1ffff },
+		{ 0x0e0b, 0x100000 }, { 0x0e0c, 0 }, { 0x0e0d, 0x1fffff }, { 0x0e0e, 0 },	/* GMEM range */
+		{ 0x0e18, 0x804 }, { 0x0e17, 0x4 },	/* UCHE_FILTER_CNTL, CACHE_WAYS */
+		{ 0x08c2, 0x02000140 }, { 0x08c1, 0x8040362c }, { 0x08c3, 128 },	/* ROQ, mem pool */
+		{ 0x098d, 1 }, { 0x0500, 1 },		/* CP_AHB_CNTL, RBBM_PERFCTR_CNTL */
+		{ 0x001f, (1u << 30) | 0x1fffff },	/* RBBM_INTERFACE_HANG_INT_CNTL */
+		{ 0x0e19, (1u << 7) | 1 },		/* UCHE_CLIENT_PF */
+		{ 0x9e00, 0x00180000 },			/* PC_DBG_ECO_CNTL: prim_fifo_threshold */
+		{ 0x08d0, 0 },				/* CP_PERFCTR_CP_SEL[0]: always count */
+		/* a6xx_set_ubwc_config: highest bank bit 15 (hbb_lo 2), AMSBC, UBWC 3 */
+		{ 0x8e08, (1u << 4) | (2u << 1) }, { 0xb604, 2u << 1 }, { 0xae02, 2u << 1 },
+		{ 0x0e01, 2u << 21 }, { 0x0534, 0 },
+	};
+	for (unsigned i = 0; i < sizeof(init) / sizeof(init[0]); i++)
+		wr32(GREG(init[i][0]), init[i][1]);
+
+	a6_mark("cp:sqe");
+	uint32_t len;
+	const uint8_t *sqe = a6_firmware("a630_sqe.fw", &len);
+	if (!sqe || len < 8 || len > 0x10000)
+		return -1;
+	a6_write(a6_pool_pa(g, A6_OFF_SQE), sqe + 4, (len - 4 + 3) & ~3u);	/* minus the first dword */
+	wr32(GREG(CP_SQE_INSTR_BASE), (uint32_t)a6_pool_va(A6_OFF_SQE));
+	wr32(GREG(CP_SQE_INSTR_BASE + 1), 0);
+	wr32(GREG(CP_RB_BASE), (uint32_t)a6_pool_va(A6_OFF_RING));
+	wr32(GREG(CP_RB_BASE + 1), 0);
+	wr32(GREG(CP_RB_CNTL), 0x0800020c);	/* 32K ring, 32-byte blocks, no rptr update */
+	g->wptr = 0;
+	wr32(GREG(CP_SQE_CNTL), 1);
+
+	a6_mark("cp:me-init");
+	uint32_t me_init[] = { a6_pkt7(A6_CP_ME_INIT, 8), 0x2f, 3, 0x20000000, 0, 0, 0, 0, 0 };
+	if (a6_ring(g, me_init, 9, "me_init", 1000))
+		return -1;
+	a6_mark("cp:zap");
+	if (zap_enable && zap_load(g))
+		return -1;
+	a6_mark("cp:secure-off");
+	uint32_t secure[] = { a6_pkt7(A6_CP_SET_SECURE_MODE, 1), 0 };
+	return a6_ring(g, secure, 2, "secure mode off", 1000);
+}
+
+int a6_stop_phase;	/* 0 = stop before the pool work; 1..4 = after that phase; -1 = never */
+
+static void
+a6_halt_here(const char *what)
+{
+	a6_log("*** STOP after %s (sweeta6xx_stop)\n", what);
+	/*
+	 * A panic, not a WFE loop: bring-up runs on its own kernel thread, so a
+	 * sleeping thread does not stop the rest of the boot and the GUI soon
+	 * paints over the text. A panic stops every CPU and draws its message
+	 * over everything, which is the only frame that survives long enough to
+	 * be photographed.
+	 */
+	panic("SWEET A6XX STOP after %s (sweeta6xx_stop=%d) marked '%s'", what, a6_stop_phase,
+	    a6_core_step);
+}
+
+int a6_power_up(struct a6_gpu *g)
+{
+	a6_core_phase = 1;
+	a6_log("phase 1/4: CX power, clocks\n");
+	if (power_cx()) {
+		a6_log("phase 1 FAILED (cx)\n");
+		return -1;
+	}
+	a6_log("phase 1 OK (cx up)\n");
+	if (a6_stop_phase == 1) {
+		a6_halt_here("phase 1 cx");
+	}
+
+	a6_log("phase 2/4: GMU firmware + CM3\n");
+	a6_core_phase = 2;
+	if (gmu_boot(g)) {
+		a6_log("phase 2 FAILED (gmu boot)\n");
+		return -1;
+	}
+	a6_log("phase 2 OK (CM3 booted)\n");
+	if (a6_stop_phase == 2) {
+		a6_halt_here("phase 2 gmu boot");
+	}
+
+	a6_log("phase 3/4: HFI queues\n");
+	a6_core_phase = 3;
+	if (gmu_hfi(g)) {
+		a6_log("phase 3 FAILED (hfi)\n");
+		return -1;
+	}
+	a6_log("phase 3 OK (hfi up)\n");
+	if (a6_stop_phase == 3) {
+		a6_halt_here("phase 3 hfi");
+	}
+
+	a6_log("phase 4/4: SQE, CP, zap\n");
+	a6_core_phase = 4;
+	if (gpu_cp(g)) {
+		a6_log("phase 4 FAILED (cp)\n");
+		return -1;
+	}
+	a6_log("phase 4 OK (cp running)\n");
+	if (a6_stop_phase == 4) {
+		a6_halt_here("phase 4 cp");
+	}
+	a6_core_phase = 5;
+	a6_mark("core:done");
+	return 0;
+}
+
+/* ---- 2D blit (turnip's r2d path for vkCmdBlitImage, captured on the A640) ---- */
+
+/* The A640 state turnip writes before any work (tu6_init_hw + the device's magic registers). */
+static const uint32_t blit_init[][2] = {
+	{ 0x9804, 0x1f }, { 0x9805, 1 }, { 0xa0f8, 1 }, { 0xb600, 0x8000 }, { 0x8600, 0 },
+	{ 0xae03, 0x420 }, { 0xae00, 0 }, { 0xbe04, 0 }, { 0x9600, 0x2000000 }, { 0x0e12, 1 },
+	{ 0x8e01, 1 }, { 0x8e04, 0x4100000 }, { 0xae04, 0 }, { 0xae0f, 0x3f }, { 0xb605, 0x44 },
+	{ 0xbe00, 0x80 }, { 0xbe01, 0 }, { 0xab20, 0 }, { 0xb182, 0 }, { 0xbb11, 0 }, { 0xa9a8, 0 },
+	{ 0xab00, 5 }, { 0xa009, 3 }, { 0x8811, 0x10 }, { 0x8110, 0 }, { 0x8818, 0 }, { 0x8819, 0 },
+	{ 0x881a, 0 }, { 0x881b, 0 }, { 0x881c, 0 }, { 0x881d, 0 }, { 0x881e, 0 }, { 0x88f0, 0 },
+	{ 0x9236, 0 }, { 0x9300, 0 }, { 0x9306, 1 }, { 0xb183, 0 }, { 0x80af, 0 }, { 0x8099, 0 },
+	{ 0x980a, 0 }, { 0x9210, 0 }, { 0x9211, 0 }, { 0x9602, 0 }, { 0x9e72, 0 }, { 0xb309, 0xa2 },
+	{ 0xb986, 0xfc }, { 0xa007, 0 }, { 0x8864, 0 }, { 0xb800, 0x102 },
+	{ 0x8e07, 0x10000000 },		/* RB_CCU_CNTL: sysmem, full CCU */
+};
+
+#define EV_CACHE_FLUSH_TS	0x04
+#define EV_PC_CCU_INVALIDATE_COLOR 0x19
+#define EV_PC_CCU_FLUSH_DEPTH_TS 0x1c
+#define EV_PC_CCU_FLUSH_COLOR_TS 0x1d
+#define EV_CACHE_INVALIDATE	0x31
+
+uint32_t a6_blit_ib(const struct a6_gpu *g, const struct a6_blit *b, uint32_t *dw)
+{
+	(void)g;
+	uint32_t n = 0;
+	uint64_t border = a6_pool_va(A6_OFF_SCRATCH + 0x800), ts = a6_pool_va(A6_OFF_SCRATCH + 0x900);
+#define EV(e)		do { dw[n++] = a6_pkt7(A6_CP_EVENT_WRITE, 1); dw[n++] = (e); } while (0)
+#define EV_TS(e)	do { dw[n++] = a6_pkt7(A6_CP_EVENT_WRITE, 4); dw[n++] = (e); dw[n++] = (uint32_t)ts; \
+			     dw[n++] = (uint32_t)(ts >> 32); dw[n++] = 0; } while (0)
+#define REG(r, v)	do { dw[n++] = a6_pkt4((r), 1); dw[n++] = (v); } while (0)
+	EV(EV_CACHE_INVALIDATE);
+	REG(0xbb08, 0xfffff);		/* SP_UPDATE_CNTL */
+	dw[n++] = a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0);
+	for (unsigned i = 0; i < sizeof(blit_init) / sizeof(blit_init[0]); i++)
+		REG(blit_init[i][0], blit_init[i][1]);
+	dw[n++] = a6_pkt4(0xb302, 2);	/* TPL1_GFX_BORDER_COLOR_BASE */
+	dw[n++] = (uint32_t)border;
+	dw[n++] = (uint32_t)(border >> 32);
+	dw[n++] = a6_pkt4(0xb180, 2);	/* TPL1_CS_BORDER_COLOR_BASE */
+	dw[n++] = (uint32_t)border;
+	dw[n++] = (uint32_t)(border >> 32);
+	EV_TS(EV_PC_CCU_FLUSH_COLOR_TS);
+	EV(EV_PC_CCU_INVALIDATE_COLOR);
+	EV(EV_CACHE_INVALIDATE);
+	dw[n++] = a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0);
+
+	REG(0x8c01, 0);			/* RB_A2D_PIXEL_CNTL */
+	REG(0x8c00, 0x00f03000);	/* RB_A2D_BLT_CNTL: 8888 UNORM, mask f */
+	REG(0x8400, 0x00f03000);	/* GRAS_A2D_BLT_CNTL */
+	REG(0xacc0, 0xf180);		/* SP_A2D_OUTPUT_INFO */
+	dw[n++] = a6_pkt4(0x8405, 2);	/* GRAS_A2D_DEST_TL, _BR (inclusive) */
+	dw[n++] = b->dx | (b->dy << 16);
+	dw[n++] = (b->dx + b->dw - 1) | ((b->dy + b->dh - 1) << 16);
+	dw[n++] = a6_pkt4(0x8401, 4);	/* GRAS_A2D_SRC_XMIN..YMAX, 24.8 fixed, inclusive */
+	dw[n++] = b->sx << 8;
+	dw[n++] = (b->sx + b->sw - 1) << 8;
+	dw[n++] = b->sy << 8;
+	dw[n++] = (b->sy + b->sh - 1) << 8;
+	dw[n++] = a6_pkt4(0xb4c0, 5);	/* TPL1_A2D_SRC_TEXTURE_INFO, SIZE, BASE, PITCH */
+	dw[n++] = 0x00500430 | (b->filter ? 0x10000 : 0);	/* 8888, linear, WXYZ, UNK20|UNK22 */
+	dw[n++] = b->src_w | (b->src_h << 15);
+	dw[n++] = (uint32_t)b->src_iova;
+	dw[n++] = (uint32_t)(b->src_iova >> 32);
+	dw[n++] = b->src_pitch << 3;
+	dw[n++] = a6_pkt4(0xb4ca, 3);	/* TPL1_A2D_SRC_TEXTURE_FLAG_BASE, _PITCH */
+	dw[n++] = (uint32_t)b->src_iova;
+	dw[n++] = (uint32_t)(b->src_iova >> 32);
+	dw[n++] = 0;
+	dw[n++] = a6_pkt4(0x8c17, 4);	/* RB_A2D_DEST_BUFFER_INFO, BASE, PITCH (64 B units) */
+	dw[n++] = 0x430;
+	dw[n++] = (uint32_t)b->dst_iova;
+	dw[n++] = (uint32_t)(b->dst_iova >> 32);
+	dw[n++] = b->dst_pitch >> 6;
+	dw[n++] = a6_pkt4(0x8c20, 3);	/* RB_A2D_DEST_FLAG_BUFFER_BASE, _PITCH */
+	dw[n++] = (uint32_t)b->dst_iova;
+	dw[n++] = (uint32_t)(b->dst_iova >> 32);
+	dw[n++] = 0;
+	dw[n++] = a6_pkt7(A6_CP_BLIT, 1);
+	dw[n++] = 3;			/* BLIT_OP_SCALE */
+	EV_TS(EV_PC_CCU_FLUSH_COLOR_TS);
+	EV_TS(EV_PC_CCU_FLUSH_DEPTH_TS);
+	EV_TS(EV_CACHE_FLUSH_TS);
+#undef EV
+#undef EV_TS
+#undef REG
+	return n;
+}
+#endif
diff --git a/bsd/dev/sweet_a6xx_host.c b/bsd/dev/sweet_a6xx_host.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_a6xx_host.c
@@ -0,0 +1,738 @@
+/*
+ * Kernel environment for the Adreno 640 core in sweet_a6xx.c.
+ *
+ * The core is the one that was proven on this phone in bare metal (shim-rmx):
+ * CX/GX power, GMU firmware, HFI, SMMU, SQE, CP ring, zap and the blit stream.
+ * It only needs eight environment calls, and this file is that environment.
+ *
+ * Boot arguments:
+ *   sweeta6xx=0  (default) do nothing at all
+ *   sweeta6xx=1  power the GPU, boot the GMU, bring the CP up WITHOUT the zap
+ *                shader: no SCM call is made in this stage, so a TrustZone
+ *                surprise cannot cost the run
+ *   sweeta6xx=2  additionally load and authenticate the zap shader (PAS 13)
+ *   sweeta6xx=3  2 plus a CP self-test: the ring asks CP_MEM_WRITE to put a
+ *                magic value into the pool, the CPU reads it back
+ *   sweetzap=0x...  /reserved-memory/pil_gpu_region as the bootloader actually
+ *                placed it (shim-rmx reads the live tree; ABL rebases the whole
+ *                pil_* group by 4 MiB, so the static DTB value is wrong)
+ *
+ * Firmware comes from the device tree as /chosen "gpufw,<name>", written by
+ * tools/mkpayload.py --gpufw DIR.
+ */
+#if defined(ARM64_BOARD_CONFIG_GUACAMOLE)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <kern/debug.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include <mach/mach_time.h>
+#include "sweet_a6xx.h"
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern boolean_t pmap_valid_address(uint64_t pa);
+extern vm_map_address_t phystokv(uint64_t pa);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern kern_return_t thread_terminate(thread_t);
+extern int hz;		/* kern/clock.c; tsleep ticks, not in every header set */
+extern int vprintf(const char *fmt, va_list ap);
+
+void sweet_a6xx_init(void);
+
+static struct a6_gpu gpu;
+static vm_offset_t pool_kva;
+static volatile bool gpu_ready;
+static int resolved_stage;	/* sweeta6xx (or the gpu= alias) resolved in init */
+static LCK_GRP_DECLARE(sweet_a6xx_grp, "sweet_a6xx");
+static LCK_MTX_DECLARE(sweet_a6xx_lock, &sweet_a6xx_grp);
+
+/* ---- environment ---- */
+
+#define GPU_WIN		0x200000ULL
+#define GPU_MAPS	24
+
+static struct {
+	vm_offset_t va;
+	uint64_t win;
+} gpu_map[GPU_MAPS];
+
+/* Device windows: 2 MB, kept for good (there are only a handful of blocks). */
+static volatile uint32_t *
+gpu_io(uint64_t pa)
+{
+	uint64_t win = pa & ~(GPU_WIN - 1);
+	for (unsigned i = 0; i < GPU_MAPS; i++) {
+		if (gpu_map[i].va && gpu_map[i].win == win) {
+			return (volatile uint32_t *)(gpu_map[i].va + (pa - win));
+		}
+		if (!gpu_map[i].va) {
+			gpu_map[i].va = ml_io_map_unmappable((vm_offset_t)win, GPU_WIN, VM_WIMG_IO);
+			gpu_map[i].win = win;
+			return gpu_map[i].va ? (volatile uint32_t *)(gpu_map[i].va + (pa - win)) : NULL;
+		}
+	}
+	panic("sweet_a6xx: out of device windows at 0x%llx", pa);
+}
+
+static bool
+in_pool(uint64_t pa, size_t len)
+{
+	return pool_kva && pa >= gpu.pool_pa && pa + len <= gpu.pool_pa + A6_POOL_SIZE;
+}
+
+uint32_t
+a6_rd(uint64_t pa)
+{
+	uint32_t v;
+	if (in_pool(pa, 4)) {
+		(void)a6_read(pa, &v, 4);
+		return v;
+	}
+	v = *gpu_io(pa);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+void
+a6_wr(uint64_t pa, uint32_t v)
+{
+	if (in_pool(pa, 4)) {
+		(void)a6_write(pa, &v, 4);
+		return;
+	}
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*gpu_io(pa) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+/* Pool and other kernel RAM: through the physmap, cleaned to the point of
+ * coherency. MMIO: words. */
+int
+a6_write(uint64_t pa, const void *buf, size_t len)
+{
+	if (in_pool(pa, len)) {
+		memcpy((void *)(pool_kva + (pa - gpu.pool_pa)), buf, len);
+		flush_dcache64((addr64_t)pa, (unsigned)len, TRUE);
+		return 0;
+	}
+	if (pmap_valid_address(pa)) {
+		memcpy((void *)phystokv(pa), buf, len);
+		flush_dcache64((addr64_t)pa, (unsigned)len, TRUE);
+		return 0;
+	}
+	const uint32_t *w = buf;
+	for (size_t i = 0; i < len / 4; i++) {
+		a6_wr(pa + 4 * i, w[i]);
+	}
+	return 0;
+}
+
+int
+a6_read(uint64_t pa, void *buf, size_t len)
+{
+	if (in_pool(pa, len)) {
+		flush_dcache64((addr64_t)pa, (unsigned)len, TRUE);
+		memcpy(buf, (const void *)(pool_kva + (pa - gpu.pool_pa)), len);
+		return 0;
+	}
+	uint32_t *w = buf;
+	for (size_t i = 0; i < len / 4; i++) {
+		w[i] = a6_rd(pa + 4 * i);
+	}
+	return 0;
+}
+
+void
+a6_delay_ms(unsigned ms)
+{
+	delay((int)ms * 1000);
+}
+
+void
+a6_log(const char *fmt, ...)
+{
+	va_list ap;
+	printf("SWEET A6XX: ");
+	va_start(ap, fmt);
+	vprintf(fmt, ap);
+	va_end(ap);
+}
+
+/*
+ * SMC64 (SMCCC) with x0..x7 in and out. The shim does this from bare metal and
+ * it works; the kernel path is unproven, which is why stage 1 does not use it.
+ */
+void
+a6_smc(uint64_t x[8])
+{
+	register uint64_t x0 __asm__("x0") = x[0];
+	register uint64_t x1 __asm__("x1") = x[1];
+	register uint64_t x2 __asm__("x2") = x[2];
+	register uint64_t x3 __asm__("x3") = x[3];
+	register uint64_t x4 __asm__("x4") = x[4];
+	register uint64_t x5 __asm__("x5") = x[5];
+	register uint64_t x6 __asm__("x6") = x[6];
+	register uint64_t x7 __asm__("x7") = x[7];
+
+	__asm__ __volatile__("smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3),
+	      "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+	    :
+	    : "memory");
+	x[0] = x0; x[1] = x1; x[2] = x2; x[3] = x3;
+	x[4] = x4; x[5] = x5; x[6] = x6; x[7] = x7;
+}
+
+const uint8_t *
+a6_firmware(const char *name, uint32_t *len)
+{
+	DTEntry chosen;
+	void const *data;
+	unsigned size;
+	char prop[40];
+
+	snprintf(prop, sizeof(prop), "gpufw,%s", name);
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, prop, &data, &size) != kSuccess) {
+		a6_log("no firmware %s in the device tree (mkpayload.py --gpufw)\n", name);
+		return NULL;
+	}
+	*len = size;
+	return data;
+}
+
+/* ---- CP self-test: the GPU must write the value, the CPU must read it ---- */
+
+#define A6_TEST_MAGIC	0xcafef00dU
+
+static void
+a6_self_test(struct a6_gpu *g)
+{
+	uint64_t dst = a6_pool_pa(g, A6_OFF_SCRATCH + 0x100);
+	uint32_t zero = 0, got;
+	uint32_t dw[8];
+	uint32_t n = 0;
+
+	(void)a6_write(dst, &zero, sizeof(zero));
+	dw[n++] = a6_pkt7(A6_CP_MEM_WRITE, 3);	/* 2 address dwords + 1 value */
+	dw[n++] = (uint32_t)dst;
+	dw[n++] = (uint32_t)(dst >> 32);
+	dw[n++] = A6_TEST_MAGIC;
+	int rc = a6_ring(g, dw, n, "ktest", 500);
+	got = a6_rd(dst);
+	a6_log("ktest: rc %d ring -> %x (want %x)%s\n", rc, got, A6_TEST_MAGIC,
+	    got == A6_TEST_MAGIC ? "  *** GPU EXECUTED OUR COMMANDS ***" : "");
+}
+
+/* ---- bring-up ---- */
+
+/*
+ * Watchdog. Bring-up runs on its own kernel thread, so when it wedges (an
+ * MMIO access that never returns, a GMU that never acks) it prints nothing
+ * more and the rest of the boot carries on until the GUI paints over the
+ * console: the stall is invisible, and every bisect costs a flash cycle.
+ * This thread turns that into a panic. A panic stops every CPU and draws its
+ * message over everything, so one photo of the panel names the step.
+ * sweeta6xx_wd=<seconds>, default 45, 0 = disabled.
+ */
+static int a6_wd_chan;
+
+static void
+a6_watchdog_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t secs = 45;
+
+	if (!PE_parse_boot_argn("sweeta6xx_wd", &secs, sizeof(secs))) {
+		secs = 45;
+	}
+	if (secs) {
+		a6_log("watchdog: %u s for bring-up\n", secs);
+		(void)tsleep(&a6_wd_chan, PZERO, "a6watchdog", hz * (int)secs);
+		if (!a6_core_done) {
+			panic("SWEET A6XX WATCHDOG: %u s, phase %d, step '%s', stage %d",
+			    secs, a6_core_phase, a6_core_step, resolved_stage);
+		}
+		a6_log("watchdog: bring-up finished in time, done\n");
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+gpu_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint64_t t0 = mach_absolute_time(), ns;
+	int stage = resolved_stage;
+
+	a6_mark("thread:enter");
+	lck_mtx_lock(&sweet_a6xx_lock);
+	int rc = a6_power_up(&gpu);
+	if (!rc) {
+		a6_unmap_high(&gpu);
+		gpu_ready = true;
+		if (stage >= 3) {
+			a6_self_test(&gpu);
+		}
+	}
+	lck_mtx_unlock(&sweet_a6xx_lock);
+	a6_core_done = 1;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	a6_log("bring-up stage %d %s in %llu ms (pool 0x%llx, zap %s)\n", stage,
+	    rc ? "FAILED" : "done, GPU ready", ns / 1000000, gpu.pool_pa,
+	    stage >= 2 ? "on" : "off");
+	/* One fixed line, so a single photo of the froze panel is enough evidence. */
+	a6_log("RESULT stage=%d ok=%d ready=%d cp=%d\n", stage, rc == 0, (int)gpu_ready,
+	    (int)a6_cp_running(&gpu));
+	{
+		int halt = 0;
+		if (PE_parse_boot_argn("sweeta6xx_halt", &halt, sizeof(halt)) && halt) {
+			a6_log("halting (sweeta6xx_halt=1)\n");
+			panic("SWEET A6XX RESULT: stage=%d ok=%d ready=%d cp=%d",
+			    stage, rc == 0, (int)gpu_ready, (int)a6_cp_running(&gpu));
+		}
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_a6xx_init(void)
+{
+	uint32_t stage = 0;
+	uint64_t zap = 0;
+	uint32_t alias = 0;
+	extern char *PE_boot_args(void);
+
+	a6_mark("init:enter");
+	/* Evidence first: prove the hook ran and show what the kernel actually
+	 * received. Without this a silent boot-argument mismatch looks exactly
+	 * like the driver not being in the kernel at all. */
+	int got = PE_parse_boot_argn("sweeta6xx", &stage, sizeof(stage));
+	int got_alias = PE_parse_boot_argn("gpu", &alias, sizeof(alias));
+	a6_log("init called: sweeta6xx=%u (found %d), gpu=%u (found %d)\n",
+	    stage, got, alias, got_alias);
+	a6_log("boot-args: [%s]\n", PE_boot_args() ? PE_boot_args() : "(null)");
+
+	if (!stage && alias) {
+		stage = alias;		/* ios-sweet/redwood used gpu=1 */
+	}
+	if (!stage) {
+		a6_log("no stage requested, nothing to do\n");
+		return;
+	}
+	if (PE_parse_boot_argn("sweetzap", &zap, sizeof(zap)) && zap) {
+		a6_set_zap_region(zap, 0x2000);
+	}
+	a6_set_zap_enable(stage >= 2);
+	resolved_stage = (int)stage;
+
+	/* sweeta6xx_stop=N: stop after phase N (1 CX, 2 GMU boot, 3 HFI, 4 CP),
+	 * 0 = stop before the pool work. Absent = run everything. */
+	{
+		uint32_t stop = 0;
+		a6_stop_phase = PE_parse_boot_argn("sweeta6xx_stop", &stop, sizeof(stop)) ?
+		    (int)stop : -1;
+		a6_log("stop_phase=%d\n", a6_stop_phase);
+	}
+
+	vm_offset_t va = 0;
+	if (kmem_alloc_contig(kernel_map, &va, A6_POOL_SIZE, PAGE_MASK, 0,
+	    (ppnum_t)(atop_64(A6_POOL_ALIGN) - 1),
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		a6_log("POOL FAILED: no %llu bytes of contiguous memory\n", A6_POOL_SIZE);
+		a6_log("RESULT stage=%u ok=0 ready=0 cp=0 (pool)\n", stage);
+		a6_core_done = 1;
+		panic("SWEET A6XX: no %llu bytes of contiguous memory for the GPU pool",
+		    A6_POOL_SIZE);
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+	a6_init_state(&gpu, ptoa_64(pn));
+	pool_kva = va;
+	a6_log("pool %llu bytes at kva %#llx pa %#llx\n", A6_POOL_SIZE, (uint64_t)va,
+	    gpu.pool_pa);
+	a6_mark("init:pool-ok");
+	if (a6_stop_phase == 0) {
+		a6_log("*** STOP before bring-up (sweeta6xx_stop=0)\n");
+		a6_core_done = 1;
+		panic("SWEET A6XX STOP before bring-up (sweeta6xx_stop=0)");
+	}
+	flush_dcache64((addr64_t)gpu.pool_pa, (unsigned)A6_POOL_SIZE, TRUE);
+
+	thread_t thread;
+	if (kernel_thread_start(a6_watchdog_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	if (kernel_thread_start(gpu_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+bool
+sweet_a6xx_ready(void)
+{
+	return gpu_ready;
+}
+
+/* ======================================================================
+ * The layer the display and Metal talk to. Same API the flame/rmx1931 tree
+ * exposes (sweet_gpu_{ready,surface_slot,map_surface,present,panel_stride}):
+ * iOS hands us a swapped IOSurface's pages, we point GPU virtual addresses at
+ * them, and a 2D blit stream copies/scales the frame into the panel memory
+ * without the CPU touching a pixel.
+ *
+ * Panel: OnePlus 7 Pro, 1440x3120, framebuffer at 0x9c000000 (A6_FB_PA).
+ * ====================================================================== */
+
+#define SLOTS		4
+#define SLOT_IOVA(n)	(0x100000000ULL + 0x1000000ULL * (n))
+#define SLOT_MAX	0x1000000ULL
+#define SLOT_PAGES	1024
+#define IB_OFF		A6_OFF_FREE	/* the present IB lives in the pool */
+
+#define PANEL_W		1440
+#define PANEL_H		3120
+
+/* Set by present(): where the fitted frame landed, for the touch mapping. */
+int sweet_display_fit_x, sweet_display_fit_w;
+
+static struct {
+	uint64_t key;
+	uint64_t pages[SLOT_PAGES];
+	uint32_t npages, page_size;
+	uint64_t used;
+} slot[SLOTS];
+static uint64_t slot_clock;
+static uint64_t stat_frames, stat_clean_abs, stat_gpu_abs;
+
+bool
+sweet_gpu_ready(void)
+{
+	return gpu_ready;
+}
+
+int
+sweet_gpu_surface_slot(uint64_t key)
+{
+	for (int i = 0; i < SLOTS; i++) {
+		if (slot[i].key == key && slot[i].npages) {
+			slot[i].used = ++slot_clock;
+			return i;
+		}
+	}
+	return -1;
+}
+
+int
+sweet_gpu_map_surface(uint64_t key, const uint64_t *pages, uint32_t npages, uint32_t page_size)
+{
+	if (!gpu_ready || npages > SLOT_PAGES || (uint64_t)npages * page_size > SLOT_MAX) {
+		return -1;
+	}
+	int s = 0;
+	for (int i = 1; i < SLOTS; i++) {
+		if (slot[i].used < slot[s].used) {
+			s = i;
+		}
+	}
+	lck_mtx_lock(&sweet_a6xx_lock);
+	int rc = a6_map_pages(&gpu, SLOT_IOVA(s), pages, npages, page_size);
+	a6_tlb_flush(&gpu);
+	lck_mtx_unlock(&sweet_a6xx_lock);
+	if (rc) {
+		slot[s].npages = 0;
+		return -1;
+	}
+	memcpy(slot[s].pages, pages, npages * sizeof(uint64_t));
+	slot[s].npages = npages;
+	slot[s].page_size = page_size;
+	slot[s].key = key;
+	slot[s].used = ++slot_clock;
+	a6_log("surface %llx -> slot %d (%u pages of %u)\n", key, s, npages, page_size);
+	return s;
+}
+
+/*
+ * Blit a mapped surface, scaled to fit and centred, into the panel memory.
+ * The CPU rendered that surface through the cache, so clean its pages first.
+ * Returns 0 when the GPU finished; the caller falls back to its CPU copy.
+ */
+int
+sweet_gpu_present(int s, uint32_t offset, uint32_t w, uint32_t h, uint32_t pitch,
+    uint32_t fb_pitch, uint32_t *out_dx, uint32_t *out_dw)
+{
+	if (!gpu_ready || s < 0 || s >= SLOTS || !slot[s].npages ||
+	    (pitch & 63) || (fb_pitch & 63) || h == 0 || w == 0) {
+		return -1;
+	}
+	uint64_t t0 = mach_absolute_time();
+	for (uint32_t i = 0; i < slot[s].npages; i++) {
+		flush_dcache64((addr64_t)slot[s].pages[i], slot[s].page_size, TRUE);
+	}
+	uint64_t t1 = mach_absolute_time();
+
+	struct a6_blit b = {
+		.src_iova = SLOT_IOVA(s) + offset, .src_w = w, .src_h = h, .src_pitch = pitch,
+		.sw = w, .sh = h, .dst_iova = A6_GVA_FB, .dst_pitch = fb_pitch, .filter = true,
+	};
+	/* sweetfull=1: stretch to the panel instead of fitting (the panel is 19.5:9,
+	 * iOS surfaces are not, so the default leaves bars). */
+	{
+		uint32_t full = 0;
+		if (PE_parse_boot_argn("sweetfull", &full, sizeof(full)) && full) {
+			b.dx = 0; b.dy = 0; b.dw = PANEL_W; b.dh = PANEL_H;
+			goto geometry_done;
+		}
+	}
+	/* Fit the frame into the panel, keeping the aspect ratio. */
+	if ((uint64_t)w * PANEL_H <= (uint64_t)PANEL_W * h) {
+		b.dh = PANEL_H;
+		b.dw = (uint32_t)(((uint64_t)w * PANEL_H + h / 2) / h);
+	} else {
+		b.dw = PANEL_W;
+		b.dh = (uint32_t)(((uint64_t)h * PANEL_W + w / 2) / w);
+	}
+	b.dx = (PANEL_W - b.dw) / 2;
+	b.dy = (PANEL_H - b.dh) / 2;
+
+	static uint32_t dw[A6_BLIT_MAX_DW];
+	lck_mtx_lock(&sweet_a6xx_lock);
+	uint32_t n = a6_blit_ib(&gpu, &b, dw);
+	a6_write(a6_pool_pa(&gpu, IB_OFF), dw, 4ULL * n);
+	int rc = a6_submit_ib(&gpu, a6_pool_va(IB_OFF), n, 100);
+	if (rc) {
+		uint64_t far = 0;
+		uint32_t syn = 0, fsr = a6_fault_status(&gpu, &far, &syn);
+		a6_log("present: GPU timeout (fence %u, memory %u, smmu fsr %x far %llx); CPU copy stays\n",
+		    gpu.fence, a6_fence_read(&gpu), fsr, far);
+		(void)a6_clear_fault(&gpu);
+		gpu_ready = false;	/* stop trying, do not wedge the display */
+	}
+	lck_mtx_unlock(&sweet_a6xx_lock);
+
+	uint64_t t2 = mach_absolute_time();
+	stat_clean_abs += t1 - t0;
+	stat_gpu_abs += t2 - t1;
+	if ((++stat_frames % 300) == 0) {
+		uint64_t c = 0, g = 0;
+		absolutetime_to_nanoseconds(stat_clean_abs, &c);
+		absolutetime_to_nanoseconds(stat_gpu_abs, &g);
+		a6_log("present: %llu frames, avg clean %llu us, GPU blit %llu us\n", stat_frames,
+		    c / 1000 / 300, g / 1000 / 300);
+		stat_clean_abs = stat_gpu_abs = 0;
+	}
+	if (!rc) {
+	geometry_done:
+	sweet_display_fit_x = (int)b.dx;
+		sweet_display_fit_w = (int)b.dw;
+	}
+	if (out_dx) {
+		*out_dx = b.dx;
+	}
+	if (out_dw) {
+		*out_dw = b.dw;
+	}
+	return rc;
+}
+
+/* The display engine reads the panel with this row pitch; tell the 2D engine. */
+void
+sweet_gpu_panel_stride(uint32_t stride)
+{
+	/* SSPP_VIG0/1 YSTRIDE0 on the SDE, then flush CTL0. */
+	a6_wr(0x0ae00000ULL + 0x5000 + 0x24, stride);
+	a6_wr(0x0ae00000ULL + 0x5000 + 0x2000 + 0x24, stride);
+	a6_wr(0x0ae00000ULL + 0x2000 + 0x18, 0x3);
+	a6_log("panel stride %u\n", stride);
+}
+
+/* ======================================================================
+ * GPU buffers and submission: what the Metal user client
+ * (iokit/Kernel/arm/SweetAccelerator.cpp, selectors 1..7) needs behind it.
+ *
+ * The contract is the flame/rmx1931 one, so their phone/metal driver works
+ * unmodified:
+ *   0 params      -> gpu_id, chip_id, ready
+ *   1 alloc(size) -> handle, gpu_va, size     (+ clientMemoryForType mmap)
+ *   2 free(handle)
+ *   3 import(surface id) -> handle, gpu_va, size
+ *   4 submit(va, dwords, timeout) -> fence
+ *   5 cache_flush(handle, off, len)
+ *   6 submit_async(va, dwords) -> fence
+ *   7 wait_fence(fence, timeout)
+ * ====================================================================== */
+
+#define A6_MAX_BO	256
+#define BO_VA_BASE	0x1000000000ULL	/* 64 GB: above the surface slots */
+
+struct a6_bo {
+	uint64_t gpu_va, size;
+	vm_offset_t kva;
+	uint32_t npages;
+	bool used;
+};
+
+static struct a6_bo bos[A6_MAX_BO];
+static uint64_t bo_next_va = BO_VA_BASE;
+
+int
+sweet_a6xx_bo_alloc(uint64_t size, uint64_t *out_handle, uint64_t *out_gpu_va, uint64_t *out_size)
+{
+	if (!gpu_ready || size == 0) {
+		return -1;
+	}
+	size = (size + (uint64_t)PAGE_MASK) & ~(uint64_t)PAGE_MASK;
+	int h = -1;
+	for (int i = 0; i < A6_MAX_BO; i++) {
+		if (!bos[i].used) {
+			h = i;
+			break;
+		}
+	}
+	if (h < 0) {
+		return -1;
+	}
+	vm_offset_t kva = 0;
+	if (kmem_alloc_contig(kernel_map, &kva, (vm_size_t)size, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return -1;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+	if (pn == 0) {
+		kmem_free(kernel_map, kva, (vm_size_t)size);
+		return -1;
+	}
+	uint64_t va = bo_next_va;
+	bo_next_va += (size + 0xfffffULL) & ~0xfffffULL;
+
+	lck_mtx_lock(&sweet_a6xx_lock);
+	int rc = a6_map(&gpu, va, ptoa_64(pn), size);
+	if (!rc) {
+		a6_tlb_flush(&gpu);
+	}
+	lck_mtx_unlock(&sweet_a6xx_lock);
+	if (rc) {
+		kmem_free(kernel_map, kva, (vm_size_t)size);
+		return -1;
+	}
+	bos[h].gpu_va = va;
+	bos[h].size = size;
+	bos[h].kva = kva;
+	bos[h].npages = (uint32_t)(size >> PAGE_SHIFT);
+	bos[h].used = true;
+	*out_handle = (uint64_t)h;
+	*out_gpu_va = va;
+	*out_size = size;
+	return 0;
+}
+
+int
+sweet_a6xx_bo_free(uint64_t handle)
+{
+	if (handle >= A6_MAX_BO || !bos[handle].used) {
+		return -1;
+	}
+	struct a6_bo *b = &bos[handle];
+	/* No per-range unmap in the core: keep the GPU mapping until the arena is
+	 * reset. 39-bit VA space and 256 buffers make the leak irrelevant; the
+	 * IOSurface path (C++ side) uses the slot table, not this one. */
+	kmem_free(kernel_map, b->kva, (vm_size_t)b->size);
+	memset(b, 0, sizeof(*b));
+	return 0;
+}
+
+int
+sweet_a6xx_bo_info(uint64_t handle, vm_offset_t *kva, uint64_t *size)
+{
+	if (handle >= A6_MAX_BO || !bos[handle].used) {
+		return -1;
+	}
+	*kva = bos[handle].kva;
+	*size = bos[handle].size;
+	return 0;
+}
+
+/*
+ * Called from the C++ user client (iokit/Kernel/arm/SweetAccelClient.cpp) once
+ * it has walked an IOSurface's physical pages: map them into GPU virtual
+ * addresses and hand back the GPU address the client can submit against.
+ */
+int
+sweet_a6xx_surface_import_pages(uint32_t surface_id, const uint64_t *pages, uint32_t npages,
+    uint64_t *out_gpu_va, uint64_t *out_size)
+{
+	int slot = sweet_gpu_map_surface((uint64_t)surface_id, pages, npages, 4096);
+	if (slot < 0) {
+		return -1;
+	}
+	*out_gpu_va = SLOT_IOVA(slot);
+	*out_size = (uint64_t)npages * 4096;
+	return 0;
+}
+
+int
+sweet_a6xx_submit(uint64_t ib_gpu_va, uint32_t dwords, uint32_t timeout_ms, uint32_t *out_fence)
+{
+	if (!gpu_ready || dwords == 0) {
+		return -1;
+	}
+	lck_mtx_lock(&sweet_a6xx_lock);
+	int rc = a6_submit_ib(&gpu, ib_gpu_va, dwords, timeout_ms);
+	if (out_fence) {
+		*out_fence = gpu.fence;
+	}
+	if (rc) {
+		uint64_t far = 0;
+		uint32_t syn = 0, fsr = a6_fault_status(&gpu, &far, &syn);
+		a6_log("submit: timeout (fence %u, memory %u, smmu fsr %x far %llx)\n",
+		    gpu.fence, a6_fence_read(&gpu), fsr, far);
+		(void)a6_clear_fault(&gpu);
+	}
+	lck_mtx_unlock(&sweet_a6xx_lock);
+	return rc;
+}
+
+int
+sweet_a6xx_wait_fence(uint32_t fence, uint32_t timeout_ms)
+{
+	uint32_t waited = 0;
+	while (waited <= timeout_ms) {
+		if (a6_fence_read(&gpu) >= fence) {
+			return 0;
+		}
+		a6_delay_ms(1);
+		waited++;
+	}
+	return -1;
+}
+
+int
+sweet_a6xx_bo_cache_flush(uint64_t handle, uint64_t offset, uint64_t len)
+{
+	if (handle >= A6_MAX_BO || !bos[handle].used) {
+		return -1;
+	}
+	struct a6_bo *b = &bos[handle];
+	if (offset >= b->size) {
+		return -1;
+	}
+	if (len > b->size - offset) {
+		len = b->size - offset;
+	}
+	flush_dcache64((addr64_t)(b->kva + offset), (unsigned)len, TRUE);
+	return 0;
+}
+
+#endif /* ARM64_BOARD_CONFIG_GUACAMOLE */
diff --git a/bsd/dev/sweet_accel_client.cpp b/bsd/dev/sweet_accel_client.cpp
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_accel_client.cpp
@@ -0,0 +1,281 @@
+/*
+ * SweetAccelerator user client: the door Metal talks through.
+ *
+ * SweetAccelerator.cpp publishes the IOService with MetalPluginName=SweetMetal;
+ * this class is what SweetMetal.bundle opens with IOServiceOpen() and drives.
+ * The selector numbers and the scalar in/out layout are exactly the flame /
+ * rmx1931 contract so their phone/metal driver works unmodified:
+ *
+ *   0  params                      -> [gpu_id, chip_id, ready]
+ *   1  alloc(size)                 -> [handle, gpu_va, size]   (+ mmap by handle)
+ *   2  free(handle)
+ *   3  import(surface id)          -> [surface id, gpu_va, size]
+ *   4  submit(va, dwords, timeout) -> [fence]
+ *   5  cache_flush(handle, off, len)
+ *   6  submit_async(va, dwords)    -> [fence]
+ *   7  wait_fence(fence, timeout)
+ *
+ * mmap: clientMemoryForType(type == handle) returns a descriptor over that
+ * buffer's kernel memory, so IOConnectMapMemory64 gives the client a CPU
+ * mapping of the same memory the GPU reads.
+ */
+#if defined(ARM64_BOARD_CONFIG_GUACAMOLE)
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <vm/pmap.h>
+/* SweetSurface.h lives in iokit/Kernel/arm (patch 0046) and this file compiles
+ * from bsd/dev, where neither the search path nor the compiler's per-file
+ * directory finds a bare "SweetSurface.h". Keep it relative rather than adding
+ * an include path to the kernel build. */
+#include "../../iokit/Kernel/arm/SweetSurface.h"
+
+extern "C" {
+int sweet_a6xx_bo_alloc(uint64_t size, uint64_t *h, uint64_t *gpu_va, uint64_t *sz);
+int sweet_a6xx_bo_free(uint64_t h);
+int sweet_a6xx_bo_info(uint64_t h, vm_offset_t *kva, uint64_t *sz);
+int sweet_a6xx_submit(uint64_t gpu_va, uint32_t dwords, uint32_t timeout_ms, uint32_t *fence);
+int sweet_a6xx_wait_fence(uint32_t fence, uint32_t timeout_ms);
+int sweet_a6xx_bo_cache_flush(uint64_t h, uint64_t off, uint64_t len);
+int sweet_a6xx_surface_import_pages(uint32_t id, const uint64_t *pages, uint32_t npages,
+    uint64_t *gpu_va, uint64_t *size);
+bool sweet_gpu_ready(void);
+}
+
+extern "C" IOService *sweet_accel_create_user_client(IOService *provider);
+
+class SweetAcceleratorClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetAcceleratorClient)
+	/* IOUserClient declares this virtual but this XNU does not link its body;
+	 * without an override the vtable keeps an undefined reference. */
+	IOReturn exportObjectToClient(task_t, OSObject *, ipc_port_t *) APPLE_KEXT_OVERRIDE;
+
+	IOService *fProvider;
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type,
+	    OSDictionary *properties) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options,
+	    IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetAcceleratorClient, IOUserClient)
+
+IOReturn
+SweetAcceleratorClient::exportObjectToClient(task_t, OSObject *, ipc_port_t *)
+{
+	return kIOReturnUnsupported;
+}
+
+bool
+SweetAcceleratorClient::initWithTask(task_t owningTask, void *securityID, UInt32 type,
+    OSDictionary *properties)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type, properties)) {
+		return false;
+	}
+	fProvider = NULL;
+	return true;
+}
+
+bool
+SweetAcceleratorClient::start(IOService *provider)
+{
+	if (!IOUserClient::start(provider)) {
+		return false;
+	}
+	fProvider = provider;
+	IOLog("SWEET MTL: user client opened\n");
+	return true;
+}
+
+void
+SweetAcceleratorClient::stop(IOService *provider)
+{
+	IOUserClient::stop(provider);
+}
+
+IOReturn
+SweetAcceleratorClient::clientClose(void)
+{
+	terminate(kIOServiceSynchronous);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetAcceleratorClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference)
+{
+	(void)dispatch;
+	(void)target;
+	(void)reference;
+
+	if (args == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (!sweet_gpu_ready() && selector != 0) {
+		return kIOReturnNotReady;
+	}
+
+	switch (selector) {
+	case 0: {	/* params */
+		if (args->scalarOutputCount < 3) {
+			return kIOReturnBadArgument;
+		}
+		args->scalarOutput[0] = 640;		/* Adreno 640 */
+		args->scalarOutput[1] = 0x06040001ULL;	/* guacamole chip id */
+		args->scalarOutput[2] = sweet_gpu_ready() ? 1 : 0;
+		args->scalarOutputCount = 3;
+		return kIOReturnSuccess;
+	}
+	case 1: {	/* alloc */
+		if (args->scalarInputCount < 1 || args->scalarOutputCount < 3) {
+			return kIOReturnBadArgument;
+		}
+		uint64_t h = 0, gva = 0, sz = 0;
+		if (sweet_a6xx_bo_alloc(args->scalarInput[0], &h, &gva, &sz)) {
+			return kIOReturnNoMemory;
+		}
+		args->scalarOutput[0] = h;
+		args->scalarOutput[1] = gva;
+		args->scalarOutput[2] = sz;
+		args->scalarOutputCount = 3;
+		return kIOReturnSuccess;
+	}
+	case 2:		/* free */
+		if (args->scalarInputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		return sweet_a6xx_bo_free(args->scalarInput[0]) ? kIOReturnNotFound : kIOReturnSuccess;
+
+	case 3: {
+		if (args->scalarInputCount < 1 || args->scalarOutputCount < 3) {
+			return kIOReturnBadArgument;
+		}
+		uint32_t sid = (uint32_t)args->scalarInput[0];
+		SweetSurface *s = sweet_surface_copy(sid);
+		if (s == NULL) {
+			return kIOReturnNotFound;
+		}
+		static uint64_t pages[1024];
+		uint32_t n = 0;
+		IOByteCount seg = 1;
+		for (off_t off = 0; off < (off_t)s->allocSize && n < 1024 && seg; off += seg) {
+			seg = 0;
+			addr64_t pa = s->memory ? s->memory->getPhysicalSegment(off, &seg, kIODirectionInOut) : 0;
+			if (pa == 0 || seg == 0) {
+				break;
+			}
+			for (IOByteCount k = 0; k < seg && n < 1024; k += PAGE_SIZE) {
+				pages[n++] = pa + k;
+			}
+		}
+		uint64_t gva = 0, sz = 0;
+		int rc = n ? sweet_a6xx_surface_import_pages(sid, pages, n, &gva, &sz) : -1;
+		s->release();
+		if (rc) {
+			return kIOReturnError;
+		}
+		args->scalarOutput[0] = (uint64_t)sid;
+		args->scalarOutput[1] = gva;
+		args->scalarOutput[2] = sz;
+		args->scalarOutputCount = 3;
+		return kIOReturnSuccess;
+	}
+
+	case 4: {	/* submit and wait */
+		if (args->scalarInputCount < 3 || args->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		uint32_t fence = 0;
+		IOReturn r = sweet_a6xx_submit(args->scalarInput[0], (uint32_t)args->scalarInput[1],
+		    (uint32_t)args->scalarInput[2], &fence) ? kIOReturnError : kIOReturnSuccess;
+		args->scalarOutput[0] = fence;
+		args->scalarOutputCount = 1;
+		return r;
+	}
+	case 5:		/* cache flush */
+		if (args->scalarInputCount < 3) {
+			return kIOReturnBadArgument;
+		}
+		return sweet_a6xx_bo_cache_flush(args->scalarInput[0], args->scalarInput[1],
+		    args->scalarInput[2]) ? kIOReturnBadArgument : kIOReturnSuccess;
+
+	case 6: {	/* submit, no wait */
+		if (args->scalarInputCount < 2 || args->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		uint32_t fence = 0;
+		IOReturn r = sweet_a6xx_submit(args->scalarInput[0], (uint32_t)args->scalarInput[1],
+		    500, &fence) ? kIOReturnError : kIOReturnSuccess;
+		args->scalarOutput[0] = fence;
+		args->scalarOutputCount = 1;
+		return r;
+	}
+	case 7:		/* wait fence */
+		if (args->scalarInputCount < 2) {
+			return kIOReturnBadArgument;
+		}
+		return sweet_a6xx_wait_fence((uint32_t)args->scalarInput[0],
+		    (uint32_t)args->scalarInput[1]) ? kIOReturnTimeout : kIOReturnSuccess;
+
+	default:
+		return kIOReturnUnsupported;
+	}
+}
+
+IOReturn
+SweetAcceleratorClient::clientMemoryForType(UInt32 type, IOOptionBits *options,
+    IOMemoryDescriptor **memory)
+{
+	vm_offset_t kva = 0;
+	uint64_t size = 0;
+
+	if (memory == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (sweet_a6xx_bo_info((uint64_t)type, &kva, &size) || kva == 0 || size == 0) {
+		return kIOReturnNotFound;
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withAddress((void *)kva, (IOByteCount)size,
+	    kIODirectionInOut);
+	if (md == NULL) {
+		return kIOReturnNoMemory;
+	}
+	*options = 0;
+	*memory = md;		/* the caller consumes the reference */
+	return kIOReturnSuccess;
+}
+
+IOService *
+sweet_accel_create_user_client(IOService *provider)
+{
+	SweetAcceleratorClient *client = new SweetAcceleratorClient;
+	if (client == NULL) {
+		return NULL;
+	}
+	if (!client->init()) {
+		client->release();
+		return NULL;
+	}
+	if (!client->attach(provider)) {
+		client->release();
+		return NULL;
+	}
+	client->release();	/* attach retains */
+	return client;
+}
+
+#endif /* ARM64_BOARD_CONFIG_GUACAMOLE */
+
+
+
+
diff --git a/bsd/dev/sweet_overlay.c b/bsd/dev/sweet_overlay.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_overlay.c
@@ -0,0 +1,401 @@
+/*
+ * Install a file tree into the iOS root volume at boot.
+ *
+ * macOS/iOS pick a Metal driver by loading the bundle named in the GPU
+ * service's MetalPluginName from /System/Library/Extensions. Our root image
+ * was built without SweetMetal.bundle, and re-flashing 11.3 GB to add three
+ * files is not acceptable. So the bundle travels inside the payload as a
+ * ustar blob on /chosen ("sweet-overlay", written by mkpayload.py --overlay)
+ * and is unpacked here, after the root is mounted and before launchd asks for
+ * a Metal device.
+ *
+ * Entries are applied in archive order. Directories are created as needed,
+ * files are written whole, symlinks are recreated. A stamp file records the
+ * FNV-1a hash of the blob so a second boot with the same payload does nothing.
+ */
+#if defined(ARM64_BOARD_CONFIG_GUACAMOLE)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/vnode.h>
+#include <sys/namei.h>
+#include <sys/uio.h>
+#include <sys/kauth.h>
+#include <sys/mount.h>
+#include <sys/vnode_if.h>
+#include <sys/vnode_internal.h>	/* vnode_setsize: not in the public vnode.h */
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <kern/debug.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+
+/* The arm64 kernel build has -Werror=implicit-function-declaration and neither
+ * of these is reachable from the headers above; declare them exactly as XNU
+ * defines them (sweet_a6xx_host.c declares thread_terminate the same way). */
+extern kern_return_t thread_terminate(thread_t);
+
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern int vprintf(const char *fmt, va_list ap);
+
+#define OV_STAMP	"/private/var/local/.sweet-overlay"
+#define OV_MAXPATH	320
+
+static void
+ov_log(const char *fmt, ...)
+{
+	va_list ap;
+	printf("SWEET OVERLAY: ");
+	va_start(ap, fmt);
+	vprintf(fmt, ap);
+	va_end(ap);
+}
+
+static uint64_t
+ov_octal(const uint8_t *p, unsigned len)
+{
+	uint64_t v = 0;
+	for (unsigned i = 0; i < len; i++) {
+		if (p[i] >= '0' && p[i] <= '7') {
+			v = (v << 3) | (uint64_t)(p[i] - '0');
+		} else if (p[i] == 0 || p[i] == ' ') {
+			break;
+		}
+	}
+	return v;
+}
+
+static int
+ov_mkdir(const char *path, int mode)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+
+	if (vnode_lookup(path, 0, &vp, ctx) == 0) {
+		vnode_put(vp);
+		return 0;		/* already there */
+	}
+	/* parent */
+	char parent[OV_MAXPATH];
+	strlcpy(parent, path, sizeof(parent));
+	char *slash = strrchr(parent, '/');
+	if (slash == NULL || slash == parent) {
+		return -1;
+	}
+	*slash = 0;
+	if (ov_mkdir(parent, 0755) != 0) {
+		return -1;
+	}
+
+	struct componentname cn;
+	struct vnode_attr va;
+	vnode_t dvp = NULLVP;
+
+	if (vnode_lookup(parent, 0, &dvp, ctx) != 0) {
+		return -1;
+	}
+	bzero(&cn, sizeof(cn));
+	cn.cn_nameptr = slash + 1;
+	cn.cn_namelen = (uint32_t)strlen(slash + 1);
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_type, VDIR);
+	VATTR_SET(&va, va_mode, mode & 07777);
+	int err = VNOP_MKDIR(dvp, &cn, &va, &vp, ctx);
+	if (err == 0 && vp != NULLVP) {
+		vnode_put(vp);
+	}
+	vnode_put(dvp);
+	return err == 0 ? 0 : -1;
+}
+
+static void
+ov_mkdirs_parent(const char *path)
+{
+	char parent[OV_MAXPATH];
+	strlcpy(parent, path, sizeof(parent));
+	char *slash = strrchr(parent, '/');
+	if (slash == NULL || slash == parent) {
+		return;
+	}
+	*slash = 0;
+	(void)ov_mkdir(parent, 0755);
+}
+
+/* Kernel vnode lookups need a leading slash; ustar names never have one. */
+static const char *
+ov_abs(const char *path, char *buf, size_t bufsz)
+{
+	if (path[0] == '/') {
+		return path;
+	}
+	snprintf(buf, bufsz, "/%s", path);
+	return buf;
+}
+
+static int ov_last_errno;
+
+static int
+ov_write_file(const char *path, const uint8_t *data, uint64_t size, int mode)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err;
+	char abuf[OV_MAXPATH];
+	const char *apath = ov_abs(path, abuf, sizeof(abuf));
+
+	path = apath;
+	ov_mkdirs_parent(path);
+	err = vnode_open(path, O_CREAT | O_TRUNC | FWRITE, mode & 07777, 0, &vp, ctx);
+	if (err != 0) {
+		ov_last_errno = err;
+		ov_log("open %s failed err %d\n", path, err);
+		return -1;
+	}
+	int seterr = vnode_setsize(vp, 0, 0, ctx);
+	if (seterr != 0) {
+		ov_log("setsize %s failed err %d\n", path, seterr);
+	}
+	uint64_t off = 0;
+	while (off < size) {
+		size_t chunk = (size_t)MIN((uint64_t)PAGE_SIZE, size - off);
+		int resid = 0;
+		err = vn_rdwr(UIO_WRITE, vp, (caddr_t)(data + off), (int)chunk, (off_t)off,
+		    UIO_SYSSPACE, IO_UNIT | IO_SYNC, vfs_context_ucred(ctx), &resid,
+		    vfs_context_proc(ctx));
+		if (err != 0) {
+			ov_log("write %s off %llu failed err %d\n", path,
+			    (unsigned long long)off, err);
+			vnode_close(vp, FWRITE, ctx);
+			return -1;
+		}
+		if (resid == (int)chunk) {
+			ov_log("write %s off %llu stalled (resid %d)\n", path,
+			    (unsigned long long)off, resid);
+			vnode_close(vp, FWRITE, ctx);
+			return -1;
+		}
+		off += (uint64_t)chunk - (uint64_t)resid;
+	}
+	(void)vnode_close(vp, FWRITE, ctx);
+
+	struct vnode_attr va;
+	if (vnode_lookup(path, 0, &vp, ctx) == 0) {
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_mode, mode & 07777);
+		(void)vnode_setattr(vp, &va, ctx);
+		vnode_put(vp);
+	}
+	return 0;
+}
+
+static int
+ov_symlink(const char *path, const char *target)
+{
+	/* This XNU has no vn_symlink(), and the overlay only ships regular files
+	 * (the Metal bundle), so a link is logged and skipped instead of failing
+	 * the whole injection. */
+	ov_log("skip symlink %s -> %s (not supported here)\n", path, target);
+	return -1;
+}
+
+static uint64_t
+ov_hash(const uint8_t *p, unsigned len)
+{
+	uint64_t h = 14695981039346656037ULL;
+	for (unsigned i = 0; i < len; i++) {
+		h = (h ^ p[i]) * 1099511628211ULL;
+	}
+	return h;
+}
+
+static int
+ov_stamp_matches(uint64_t h)
+{
+	char want[20];
+	snprintf(want, sizeof(want), "%016llx\n", (unsigned long long)h);
+
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int match = 0;
+
+	if (vnode_lookup(OV_STAMP, 0, &vp, ctx) != 0) {
+		return 0;
+	}
+	char have[20];
+	int resid = 0;
+	bzero(have, sizeof(have));
+	int err = vn_rdwr(UIO_READ, vp, (caddr_t)have, 17, 0, UIO_SYSSPACE, 0,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	vnode_put(vp);
+	if (err == 0 && resid == 0 && memcmp(have, want, 17) == 0) {
+		match = 1;
+	}
+	return match;
+}
+
+/*
+ * This hook runs from the UFS probe, which is earlier than the rootrw=1 remount,
+ * so a lookup of /System/Library succeeds while the mount is still read-only and
+ * every write fails with EROFS. Poll a real write to the same mount instead.
+ */
+static int
+ov_wait_writable(void)
+{
+	static const uint8_t probe[1] = { 'x' };
+	/* /private/var/local may not exist yet: creating it is itself the first
+	 * writability test, and probing a missing directory always fails ENOENT. */
+	(void)ov_mkdir("/private/var", 0755);
+	(void)ov_mkdir("/private/var/local", 0777);
+	/* Fail fast: with sweetovl_halt=1 the first failure is answered by a panic,
+	 * so a photo names the errno within a couple of seconds instead of a minute. */
+	uint32_t hf = 0;
+	int fast = PE_parse_boot_argn("sweetovl_halt", &hf, sizeof(hf)) && hf;
+	for (int i = 0; i < (fast ? 4 : 120); i++) {
+		if (ov_write_file("/private/var/local/.ovprobe", probe, 1, 0644) == 0) {
+			ov_log("root is writable after %d ms\n", i * 500);
+			return 0;
+		}
+		if (i % 20 == 0) {
+			ov_log("still not writable after %d ms (err %d)\n", i * 500, ov_last_errno);
+		}
+		delay(500 * 1000);
+	}
+	ov_log("root never became writable (err %d)\n", ov_last_errno);
+	return -1;
+}
+
+static void
+ov_apply(void)
+{
+	if (ov_wait_writable() != 0) {
+		uint32_t hh = 0;
+		if (PE_parse_boot_argn("sweetovl_halt", &hh, sizeof(hh)) && hh) {
+			panic("SWEET OVL SKIP: root never writable (err %d)", ov_last_errno);
+		}
+		return;
+	}
+	DTEntry chosen;
+	void const *blob = NULL;
+	unsigned size = 0;
+
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "sweet-overlay", &blob, &size) != kSuccess ||
+	    blob == NULL || size < 512) {
+		return;			/* no overlay in this payload */
+	}
+	const uint8_t *bytes = (const uint8_t *)blob;
+	uint64_t h = ov_hash(bytes, size);
+	if (ov_stamp_matches(h)) {
+		ov_log("stamp %016llx already applied\n", (unsigned long long)h);
+		return;
+	}
+
+	char path[OV_MAXPATH], link[OV_MAXPATH];
+	unsigned files = 0, dirs = 0, links = 0, errs = 0;
+	uint64_t pos = 0;
+
+	while (pos + 512 <= (uint64_t)size) {
+		const uint8_t *hdr = bytes + pos;
+		int zero = 1;
+		for (unsigned i = 0; i < 512; i++) {
+			if (hdr[i] != 0) {
+				zero = 0;
+				break;
+			}
+		}
+		if (zero) {
+			break;		/* end of archive */
+		}
+		uint64_t fsize = ov_octal(hdr + 124, 12);
+		int mode = (int)(ov_octal(hdr + 100, 8) & 07777);
+		char type = (char)hdr[156];
+		uint64_t data = pos + 512;
+		uint64_t next = data + ((fsize + 511) & ~511ULL);
+
+		/* name, then the "prefix" field when the name is a ustar split one */
+		strlcpy(path, (const char *)hdr, sizeof(path));
+		char prefix[156];
+		strlcpy(prefix, (const char *)(hdr + 345), sizeof(prefix));
+		if (prefix[0] != 0) {
+			char tmp[OV_MAXPATH];
+			snprintf(tmp, sizeof(tmp), "%s/%s", prefix, path);
+			strlcpy(path, tmp, sizeof(path));
+		}
+
+		if (type == '5') {
+			if (ov_mkdir(path, mode ? mode : 0755) == 0) {
+				dirs++;
+			} else {
+				errs++;
+			}
+		} else if (type == '2') {
+			strlcpy(link, (const char *)(hdr + 157), sizeof(link));
+			if (ov_symlink(path, link) == 0) {
+				links++;
+			} else {
+				errs++;
+			}
+		} else if (type == '0' || type == 0 || type == '7') {
+			if (ov_write_file(path, bytes + data, fsize, mode ? mode : 0644) == 0) {
+				files++;
+			} else {
+				errs++;
+				ov_log("%s failed\n", path);
+			}
+		}
+		pos = next;
+	}
+
+	/* stamp it so the next boot with the same payload skips all of this */
+	char txt[20];
+	snprintf(txt, sizeof(txt), "%016llx\n", (unsigned long long)h);
+	if (errs == 0 && ov_mkdir("/private/var/local", 0777) == 0) {
+		(void)ov_write_file(OV_STAMP, (const uint8_t *)txt, strlen(txt), 0644);
+	}
+	ov_log("%u files, %u dirs, %u links, %u errors (hash %016llx)\n", files, dirs, links,
+	    errs, (unsigned long long)h);
+	{
+		/* sweetovl_halt=1: freeze here so one photo shows whether the
+		 * bundle actually reached the root filesystem. */
+		uint32_t hh = 0;
+		if (PE_parse_boot_argn("sweetovl_halt", &hh, sizeof(hh)) && hh) {
+			panic("SWEET OVL DONE: %u files %u dirs %u errors hash %016llx",
+			    files, dirs, errs, (unsigned long long)h);
+		}
+	}
+}
+
+static void
+ov_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	/* The root volume is mounted by the time this hook runs, but give the
+	 * mount a moment to settle before touching the tree. */
+	for (int i = 0; i < 40; i++) {
+		delay(250 * 1000);
+		vfs_context_t ctx = vfs_context_kernel();
+		vnode_t vp = NULLVP;
+		if (vnode_lookup("/System/Library", 0, &vp, ctx) == 0) {
+			vnode_put(vp);
+			break;
+		}
+	}
+	ov_apply();
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_overlay_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(ov_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
