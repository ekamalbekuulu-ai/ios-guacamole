 /* Read-only liveness dump; a driver never writes these registers. */
+/*
+ * ---- TrustZone: the a640 zap shader ------------------------------------
+ *
+ * The GMU firmware is never released until TrustZone has authenticated the GPU
+ * zap shader, which is why FW_INIT_RESULT stayed at 0 instead of 0xBABEFACE in
+ * every attempt so far: a640_zap.mdt was a 0-byte placeholder in this tree.
+ * The image now comes from the stock vendor partition (work/firmware/zap).
+ *
+ * The SCM convention and the two PAS calls are the ones the K90/HackiOS driver
+ * uses on the same Qualcomm SMC interface (adreno8_cx.c: adreno8_scm_call,
+ * adreno8_zap.c: zap_pas): x0 = function, x1 = arginfo, x2..x5 = arguments,
+ * x6 = session; x0 == 1 means "interrupted, continue with session".
+ */
+#define SWEET_SCM_PAS_INIT_IMAGE	0x42000201ULL
+#define SWEET_SCM_PAS_AUTH_RESET	0x42000202ULL
+#define SWEET_PAS_ID_GPU		13u
+
+static int32_t
+sweet_scm_call(uint64_t function, uint64_t arginfo, uint64_t a0, uint64_t a1,
+    uint64_t a2, uint64_t a3, uint64_t *answer)
+{
+	uint64_t session = 0;
+
+	for (unsigned attempt = 0; attempt < 100; ++attempt) {
+		register uint64_t x0 __asm__("x0") = attempt == 0 ? function : 1;
+		register uint64_t x1 __asm__("x1") = arginfo;
+		register uint64_t x2 __asm__("x2") = a0;
+		register uint64_t x3 __asm__("x3") = a1;
+		register uint64_t x4 __asm__("x4") = a2;
+		register uint64_t x5 __asm__("x5") = a3;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+
+		__asm__ volatile ("smc #0"
+		    : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4),
+		      "+r" (x5), "+r" (x6), "+r" (x7)
+		    : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+		      "x16", "x17", "memory");
+		session = x6;
+		if (x0 != 1) {
+			if (answer != 0) {
+				*answer = x1;
+			}
+			return (int32_t)x0;
+		}
+	}
+	return -1;
+}
+
+/* Big colour block in the top-left corner: the one signal that needs no
+ * console at all. green = zap authenticated, red = PAS failed, blue = not
+ * reached. */
+static void
+sweet_fb_bar(uint32_t argb)
+{
+	vm_offset_t fb = ml_io_map(0x9c000000u, 0x00100000u);
+
+	if (fb == 0) {
+		return;
+	}
+	for (unsigned y = 0; y < 160; ++y) {
+		volatile uint32_t *row = (volatile uint32_t *)(fb + y * 5760u);
+		for (unsigned x = 0; x < 320; ++x) {
+			row[x] = argb;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static uint32_t
+sweet_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 |
+	    (uint32_t)p[3] << 24;
+}
+
+static uint16_t
+sweet_le16(const uint8_t *p)
+{
+	return (uint16_t)((uint16_t)p[0] | (uint16_t)p[1] << 8);
+}
+
+/*
+ * Assemble the metadata page and authenticate the shader. Returns true when
+ * both PAS calls answered 0.
+ */
+static bool
+gpu_zap_load(void)
+{
+	const uint8_t *img = sweet_zap_image;
+	uint32_t phoff, phnum, header_size, hash_off = 0, hash_len = 0;
+	uint32_t seg_off = 0, seg_len = 0;
+	vm_offset_t meta = 0, meta_va = 0, shader = 0, shader_va = 0;
+	uint64_t meta_pa, shader_pa, answer = ~0ULL;
+
+	if (sizeof(sweet_zap_image) < 52 || img[0] != 0x7f || img[1] != 'E' ||
+	    img[2] != 'L' || img[3] != 'F') {
+		printf("SWEET GPU: zap: not an ELF image\n");
+		return false;
+	}
+	phoff = sweet_le32(img + 28);
+	phnum = sweet_le16(img + 44);
+	if (phoff < 52 || phnum < 2 || phnum > 32 ||
+	    phoff + phnum * 32u > sizeof(sweet_zap_image)) {
+		printf("SWEET GPU: zap: bad program headers\n");
+		return false;
+	}
+	header_size = sweet_le32(img + phoff + 16);
+	if (header_size < phoff + phnum * 32u || header_size > sizeof(sweet_zap_image)) {
+		printf("SWEET GPU: zap: bad header size %#x\n", header_size);
+		return false;
+	}
+	for (unsigned i = 1; i < phnum; ++i) {
+		const uint8_t *ph = img + phoff + i * 32u;
+		uint32_t type = sweet_le32(ph);
+		uint32_t offset = sweet_le32(ph + 4);
+		uint32_t filesz = sweet_le32(ph + 16);
+		uint32_t flags = sweet_le32(ph + 24);
+
+		if ((flags & 0x07000000u) == 0x02000000u) {	/* hash segment */
+			hash_off = offset;
+			hash_len = filesz;
+			continue;
+		}
+		if (type == 1 && (flags & 0x08000000u) && filesz != 0) {
+			seg_off = offset;	/* first LOAD segment */
+			seg_len = filesz;
+		}
+	}
+	printf("SWEET GPU: zap: image %u B, hdr %#x, hash %#x+%#x, seg %#x+%#x\n",
+	    SWEET_ZAP_SIZE, header_size, hash_off, hash_len, seg_off, seg_len);
+	if (hash_len == 0 || seg_len == 0 ||
+	    hash_off + hash_len > sizeof(sweet_zap_image) ||
+	    seg_off + seg_len > sizeof(sweet_zap_image)) {
+		printf("SWEET GPU: zap: segments out of range\n");
+		return false;
+	}
+
+	/* Metadata: ELF header + hash segment, in one physical page. */
+	if (kmem_alloc(kernel_map, &meta, PAGE_SIZE,
+	    KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	meta_pa = (uint64_t)kvtophys(meta);
+	memcpy((void *)meta, img, header_size);
+	memcpy((void *)(meta + header_size), img + hash_off, hash_len);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	/* The shader itself: one contiguous, page aligned physical block. */
+	if (kmem_alloc_contig(kernel_map, &shader, 0x00100000u, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	shader_pa = (uint64_t)kvtophys(shader);
+
+	printf("SWEET GPU: zap: metadata %#llx shader %#llx size %#x\n",
+	    meta_pa, shader_pa, header_size + hash_len);
+
+	if (sweet_scm_call(SWEET_SCM_PAS_INIT_IMAGE, 0x82, SWEET_PAS_ID_GPU,
+	    meta_pa, 0, 0, &answer) != 0 || answer != 0) {
+		printf("SWEET GPU: zap: PAS init failed answer=%#llx\n", answer);
+		sweet_fb_bar(0xffff0000u);
+		return false;
+	}
+	answer = ~0ULL;
+	if (sweet_scm_call(SWEET_SCM_PAS_AUTH_RESET, 3, SWEET_PAS_ID_GPU,
+	    shader_pa, 0x00100000u, 0, &answer) != 0 || answer != 0) {
+		printf("SWEET GPU: zap: PAS auth/reset failed answer=%#llx\n", answer);
+		sweet_fb_bar(0xffff0000u);
+		return false;
+	}
+	/* The shader code goes in after authentication, as the K90 driver does. */
+	shader_va = shader;
+	memcpy((void *)shader_va, img + seg_off, seg_len);
+	__asm__ volatile("dsb sy" ::: "memory");
+	(void)meta_va;
+
+	printf("SWEET GPU: zap: authenticated\n");
+	sweet_fb_bar(0xff00ff00u);
+	return true;
+}
