+ * (adreno8_gpu.c: a8_protected[] spans and a8_ao_hwcg[] reg/value pairs).
+ *
+ * Values come from the authoritative Linux msm tables: a640_hwcg[] and the
+ * a630_protect_regs[] span list (a640 selects a630_protect in a6xx_catalog.c).
+ * Offsets are already converted from the a6xx.xml dword index to bytes, so
+ * they can be handed straight to gpu_rd()/gpu_wr() on the GPU register base.
+ *
+ * Generated by tools/gen_gpu_tables.py - do not edit by hand.
+ */
+#ifndef _SWEET_GPU_TABLES_H_
+#define _SWEET_GPU_TABLES_H_
+
+struct sweet_reg_val {
+	uint32_t off;
+	uint32_t val;
+};
+
+/* CP_PROTECT span: start | ((end - start) << 18) | (noaccess << 31) */
+struct sweet_protect_span {
+	uint32_t start;
+	uint32_t end;
+	uint32_t noaccess;
+};
