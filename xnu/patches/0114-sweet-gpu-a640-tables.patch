+/*
+ * Apply the a640 hardware clock-gating table (sweet_gpu_tables.h, generated
+ * from the Linux a640_hwcg[] register/value pairs). Ported in the shape of the
+ * K90/HackiOS driver's gpu_hwcg() (adreno8_gpu.c): write one entry, read it
+ * back, and stop at the first mismatch instead of continuing into a register
+ * block whose state is no longer known. A caller must have GX powered.
+ */
+static int
+gpu_apply_hwcg(void)
+{
+	int applied = 0;
+
+	for (unsigned i = 0; i < SWEET_A640_HWCG_COUNT; ++i) {
+		uint32_t off = sweet_a640_hwcg[i].off;
+		uint32_t want = sweet_a640_hwcg[i].val;
+		uint32_t got;
+
+		gpu_wr(gpu, off, want);
+		got = gpu_rd(gpu, off);
+		if (got != want) {
+			printf("SWEET GPU: hwcg[%u] %#x want %#x got %#x: stop\n",
+			    i, off, want, got);
+			return -1;
+		}
+		applied++;
+	}
+	printf("SWEET GPU: hwcg applied %d/%u entries\n", applied,
+	    SWEET_A640_HWCG_COUNT);
+	return 0;
+}
