+
+	/*
+	 * Step 6 is the only thing measured to wedge the SoC: rpmh=4 (RSC uCode)
+	 * and rpmh=5 (plus the PDC sequencer uCode) both survive, while rpmh=6 -
+	 * this step, the PDC TCS tables plus PDC_ENABLE - lands in EDL every
+	 * time. Enabling the PDC makes it start driving GPU power sequences
+	 * through RPMh, which the hardware refuses while the GMU is still in
+	 * reset, so it stays off until the GMU has actually booted.
+	 */
+	{
+		int want_pdc = 0;
+		(void)PE_parse_boot_argn("sweetgpu_pdc", &want_pdc, sizeof(want_pdc));
+		if (!want_pdc) {
+			printf("SWEET GPU: pdc TCS/enable skipped (sweetgpu_pdc=0)\n");
+			return rscc;
+		}
 	}
 
