+/*
+ * Read-only ARC metadata from the command DB. ARC rails (gfx.lvl, cx.lvl,
+ * mx.lvl) are not VRM registers: the resource's auxiliary table maps a raw
+ * hardware level index to an RPMh voltage corner. Dump the address and table
+ * without voting; a vote needs the dependent MX rail and the AOP contract.
+ */
+static int
+rh_arc_lookup(const char *res, uint32_t *address, uint32_t *table, uint32_t *bytes)
+{
+	uint32_t key[2] = {0, 0};
+	unsigned matches = 0;
+
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		if (slave != RH_ARC) {
+			continue;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if ((entries & 3u) || !rh_range(entries, count * RH_DB_ENTRY) ||
+		    !rh_range(aux, 0)) {
+			printf("SWEET RPMH: malformed ARC slave header %u\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			uint32_t len = rh_db16(e + 20);
+			uint32_t off = rh_db16(e + 22);
+			if ((len & 1u) || len < 2 || len > RH_ARC_MAX ||
+			    !rh_range(aux + off, len)) {
+				printf("SWEET RPMH: invalid ARC entry for %s addr=%#x len=%u\n",
+				    res, addr, len);
+				return EINVAL;
+			}
+			*address = addr;
+			*table = aux + off;
+			*bytes = len;
+			++matches;
+		}
+	}
+	if (matches != 1) {
+		printf("SWEET RPMH: %s ARC lookup matches=%u; refusing\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+void
+sweet_rpmh_arc_dump(void)
+{
+	static const char *const names[] = { "gfx.lvl", "cx.lvl", "mx.lvl" };
+	int error = 0;
+	bool locked = false;
+	for (unsigned i = 0; i < 20; ++i) {
+		if (!__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+			locked = true;
+			break;
+		}
+		delay(10);
+	}
+	if (!locked) {
+		printf("SWEET RPMH: ARC dump busy\n");
+		return;
+	}
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing ARC dump\n");
+		goto out;
+	}
+	error = rh_map();
+	if (error) {
+		goto out;
+	}
+	for (unsigned n = 0; n < sizeof(names) / sizeof(names[0]); ++n) {
+		uint32_t addr = 0, table = 0, bytes = 0;
+		error = rh_arc_lookup(names[n], &addr, &table, &bytes);
+		if (error) {
+			continue;
+		}
+		printf("SWEET RPMH: arc %s addr=%#x levels=%u:", names[n], addr, bytes / 2);
+		for (unsigned i = 0; i < bytes / 2; ++i) {
+			uint16_t level = rh_db16(table + 2u * i);
+			printf(" %u(+%u)", level, (unsigned)level + 1u);
+		}
+		printf("\n");
+	}
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+}
